<?xml version="1.0" encoding="utf-8"?>
<!-- saito's APK's manifest (build.gradle.kts gives the app id, top.exessrhub.saito, and the version). The activity is a
     GameActivity (crates/saito/android/saito/app/SaitoActivity.kt), which loads libsaito.so (the app's crate) and
     runs its android_main; the app reads its input and draws through winit, a gamepad's input through
     saito-gamepad first (docs/app.md §7). It isn't made again as the phone turns or a keyboard comes and goes
     (configChanges): winit hears the new size, and a dialog's fragment answers the activity that asked. GameActivity
     is AppCompat's, whose theme it takes. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Local network multicast/discovery (saito-nearby's NsdManager & MulticastLock) and updater proxy lookup. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- The app's update (crates/saito-updater/src/platform/android.rs): the release's APK installed over the app by the
         system's installer, which asks the player once to let the app install apps (Settings' "Install unknown
         apps"), and after that, on Android 12 and later, asks nothing, as the app updates itself. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <!-- (A touch screen isn't required: a TV or a box with a pad plays too.) -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />

    <!-- Package visibility for anti-nettai launch guard (targetSdk 34 requires explicit <queries>). -->
    <queries>
        <package android:name="net.n1gp.nettai" />
    </queries>

    <!-- The certificate verifier's (rustls-platform-verifier's Android component, whose AAR has it) network security
         config: plain HTTP to the certificate authorities' revocation lists alone. -->
    <application
        android:label="saito"
        android:icon="@mipmap/ic_launcher"
        android:hasCode="true"
        android:isGame="true"
        android:appCategory="game"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:name="saito.app.SaitoActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.AppCompat.NoActionBar"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density">
            <meta-data android:name="android.app.lib_name" android:value="saito" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
