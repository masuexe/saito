// Dark Soul AI (ABD) version mechanics reference dialog, shared by the Auto Battle editor tab and the Lobby.

import { Theme, I18n } from "theme.slint";
import { DialogFrame } from "shell.slint";
import { Button, ButtonKind, Label, Note, ScrollPage } from "widgets.slint";

component GuideCard inherits Rectangle {
    in property <string> heading;
    in property <string> body;
    in property <bool> active: false;
    border-radius: 4px;
    background: Theme.inset;
    border-width: 1px;
    border-color: root.active ? Theme.cursor : Theme.line;

    VerticalLayout {
        padding: 10px;
        spacing: 4px;

        Text {
            text: root.heading;
            color: root.active ? Theme.cursor : Theme.text;
            font-family: Theme.body;
            font-size: 13px;
            font-weight: 700;
            wrap: word-wrap;
        }

        Text {
            text: root.body;
            color: Theme.muted;
            font-family: Theme.body;
            font-size: 12px;
            wrap: word-wrap;
        }
    }
}

export component AbdGuideDialog inherits DialogFrame {
    in property <int> active-mode: 0;
    in property <bool> has-ds: false;
    in property <string> nav-prefix: "abd-guide.";
    property <length> list-h: Theme.sideways ? 210px : Theme.phone ? 340px : 380px;
    property <length> footer-y: self.list-h + 12px;
    title: @tr("Dark Soul AI (ABD) Guide");
    wide: true;
    panel-width: 600px;
    content-height: self.footer-y + 40px;

    page := ScrollPage {
        x: 0;
        y: 0;
        width: root.inner-width;
        height: root.list-h;
        nav: root.nav-prefix + "scroll.";
        content-height: cards.preferred-height;

        cards := VerticalLayout {
            width: page.view-width;
            spacing: 10px;

            GuideCard {
                heading: @tr("Common Rules (All Versions)");
                body: @tr("• Pool capacity: Standard/Dark pool holds up to 16 unique chips with 4×, 4×, 2×, 2×, 1×12 weights (24 slots), plus up to 5 Mega, 1 Giga, and 1 Program Advance.\n• Legality notices: Some chips cannot be recorded in normal play (22 in EXE4, 82 in EXE5; marked yellow in the editor). In EXE4, DarkSword is required in Standard unless all 16 Standard slots are full.\n• Tracking & cap: ABD Mega/Giga/Dark/PA chip uses per round are logged automatically (exportable as LOG/CSV/JSONL in Settings). Hosts may also enable a per-round ABD Cap (default 5; 3 matches official EXE5 tournament rules) to disable a chip for the rest of the round once reached.");
            }

            GuideCard {
                active: root.active-mode == 0;
                heading: @tr("Original (GBA)");
                body: @tr("• Plays chips strictly in your memory pool order with 4/4/2/2/1×12 weights.\n• No Dark Chip priority penalty, no high-class unlock thresholds, and no extra post-chip buster cooldown.");
            }

            GuideCard {
                active: root.active-mode == 1;
                heading: @tr("Legacy Collection (EXE4 & EXE5)");
                body: @tr("[Dark Chip Priority Penalty]\nDark Chips in the Standard pool cannot occupy the top 4 slots and are adjusted at battle start:\n• 4+ non-Dark Standard chips: Dark Chips in the top 4 swap with non-Dark chips behind them into 1× slots.\n• 3 non-Dark Standard chips: They take slots 1–3, and the first Dark Chip moves to slot 4 (2×).\n• Fewer than 3 non-Dark Standard chips: Only when a Dark Chip is present are empty spots in slots 1–3 padded with Cannon, MiniBomb, and AirShot (builds with 3+ non-Dark Standard chips never trigger padding and do not need all 16 slots filled).\n\n[High-Class Unlock Thresholds]\nUnlocked by total unique Standard + Dark chip count (Mega slots are governed only by this threshold):\n• Mega: 1 / 2 / 3 / 4 / 5 slots unlock at 3 / 6 / 10 / 14 / 16 types.\n• Giga & Program Advance: Unlock at 12 types.");
            }

            if root.has-ds: GuideCard {
                active: root.active-mode == 2;
                heading: @tr("Double Team DS (5DS — EXE5 Only)");
                body: @tr("[Auto-Sort by Internal ID]\n• Standard/Dark and Mega pools ignore manual order and sort ascending by internal chip ID at battle start.\n• Chips with lower internal IDs automatically take the top 4 slots (4×, 4×, 2×, 2×).\n\n[Post-Chip Buster Cooldown]\n• After using any of the following chips, the AI enters a cooldown (8 decision ticks, forcing 7 consecutive buster runs before attempting chips again):\n  Any Dark Chip, SearchMan (V1/SP/DS), ShakPar 1–3, BigNoise.");
            }
        }
    }

    Button {
        x: root.inner-width - self.width;
        y: root.footer-y;
        nav: root.nav-prefix + "close";
        text: I18n.upper(@tr("Close"));
        kind: ButtonKind.main;
    }
}
