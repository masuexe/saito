// Dark Soul AI (ABD) version mechanics reference dialog, shared by the Auto Battle editor tab and the Lobby.

import { Theme, I18n } from "theme.slint";
import { DialogFrame } from "shell.slint";
import { Button, ButtonKind, Label, Note, ScrollPage } from "widgets.slint";

component GuideCard inherits Rectangle {
    in property <string> heading;
    in property <string> body;
    in property <bool> active: false;
    border-radius: 4px;
    background: Theme.inset;
    border-width: 1px;
    border-color: root.active ? Theme.cursor : Theme.line;

    VerticalLayout {
        padding: 10px;
        spacing: 4px;

        Text {
            text: root.heading;
            color: root.active ? Theme.cursor : Theme.text;
            font-family: Theme.body;
            font-size: 13px;
            font-weight: 700;
            wrap: word-wrap;
        }

        Text {
            text: root.body;
            color: Theme.muted;
            font-family: Theme.body;
            font-size: 12px;
            wrap: word-wrap;
        }
    }
}

export component AbdGuideDialog inherits DialogFrame {
    in property <int> active-mode: 0;
    in property <bool> has-ds: false;
    in property <string> nav-prefix: "abd-guide.";
    property <length> list-h: Theme.sideways ? 210px : Theme.phone ? 340px : 380px;
    property <length> footer-y: self.list-h + 12px;
    title: @tr("Dark Soul AI (ABD) Guide");
    wide: true;
    panel-width: 600px;
    content-height: self.footer-y + 40px;

    page := ScrollPage {
        x: 0;
        y: 0;
        width: root.inner-width;
        height: root.list-h;
        nav: root.nav-prefix + "scroll.";
        content-height: cards.preferred-height;

        cards := VerticalLayout {
            width: page.view-width;
            spacing: 10px;

            GuideCard {
                heading: @tr("Common Rules (All Versions)");
                body: @tr("Standard pool holds up to 16 unique chips with 4×, 4×, 2×, 2×, 1×12 weights (24 slots), plus up to 5 Mega, 1 Giga, and 1 Program Advance.\nSome chips cannot be recorded in normal play (22 in EXE4, 82 in EXE5; marked with a yellow warning). In EXE4, DarkSword is required in Standard unless all 16 Standard slots are full.\nABD Mega/Giga/Dark/PA chip uses per round are logged automatically (exportable as LOG/CSV/JSONL in Settings). Hosts may also enable an optional per-round ABD Cap (default 5; 3 matches official EXE5 tournament rules) to remove any Mega/Giga/Dark/PA chip from the runtime pool once it reaches the limit.");
            }

            GuideCard {
                active: root.active-mode == 0;
                heading: @tr("Original (GBA)");
                body: @tr("Uses the memory pool's exact order and 4/4/2/2/1×12 weights with no Dark Chip priority penalty, no Mega/Giga/PA unlock thresholds, and no extra post-chip buster cooldown.");
            }

            GuideCard {
                active: root.active-mode == 1;
                heading: @tr("Legacy Collection (EXE4 & EXE5)");
                body: @tr("• Dark Chip priority penalty: Dark Chips (including EXE4 DrkVulcn in Mega) cannot occupy the top 4 slots. Only when a Dark Chip is present and fewer than 3 non-Dark Standard chips are registered are the top 3 slots padded with Cannon, MiniBomb, and AirShot (normal builds with 3+ non-Dark Standard chips do not trigger padding and do not need all 16 slots filled). With 4+ non-Dark Standard chips, Dark Chips in the top 4 are swapped down to 1× slots.\n• High-class unlock thresholds (by unique Standard/Dark chip count): Mega unlocks 1/2/3/4/5 slots at 3/6/10/14/16 unique chips; Giga and PA unlock at 12 unique chips.");
            }

            if root.has-ds: GuideCard {
                active: root.active-mode == 2;
                heading: @tr("Double Team DS (5DS — EXE5 Only)");
                body: @tr("• Internal ID sort: Before applying 4/4/2/2/1×12 weights, Standard/Dark and Mega pools are sorted by internal BattleChip ID ascending (earlier IDs automatically take the higher 4×/4×/2×/2× weights instead of usage order).\n• Post-chip buster cooldown: After using any Dark Chip, SearchMan (V1/SP/DS), ShakPar (1–3), or BigNoise, the AI must fire 8 three-shot buster runs (vs 2 in Original) before attempting another chip.");
            }
        }
    }

    Button {
        x: root.inner-width - self.width;
        y: root.footer-y;
        nav: root.nav-prefix + "close";
        text: I18n.upper(@tr("Close"));
        kind: ButtonKind.main;
    }
}
