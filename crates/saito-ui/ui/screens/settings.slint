// Settings (docs/design/app-ui.md §6): one scrolling page, and a list at its left that jumps to a group. Each
// row is a label, a control of one width, and a note only where the label can't say it. On a phone the list is
// left out and the note goes under its control. The About group's SHOW LICENSES opens About in the page's place
// (settings/about.slint), its Back coming back to the page.

import { Theme, Audit, I18n } from "../theme.slint";
import { Nav, NavKind, Focusable } from "../nav.slint";
import { Shell, Page, PadButton, FaceButton, NearbyWords } from "../shell.slint";
import { Label, Note, Mono, Button, ButtonKind, Field, Select, Seg, Slider, Stepper, Row, Marker, GroupTitle, ScrollPage, Reach } from "../widgets.slint";
import { Arrive } from "../motion.slint";
import { AboutPage, AboutOverlay } from "settings/about.slint";
import { TouchLayoutEditor } from "settings/touch_pad.slint";

// A pad's button bound to an action: one of its four face buttons, drawn by its place, or a button with a cap.
export struct PadBinding {
    face: PadButton,
    text: string,
}

// What the settings show: src/screens/settings.rs sets these.
export global SettingsView {
    // The group the list marks: the one the focus is in, or the one scrolled to.
    in property <int> group;
    callback scrolled(length, length, length, [length]);
    in property <string> name;
    in property <string> language;
    in property <string> picture-size;
    in property <bool> full-screen;
    in property <bool> is-android;
    in property <bool> hide-landscape-status-bar;
    in property <bool> reduce-motion;
    in property <bool> reduce-flashes;
    in property <bool> hide-aura-number;
    in property <bool> check-updates;
    in property <bool> can-update;
    in property <string> update-note;
    in property <bool> keyboard-only-custom;
    in property <bool> landscape-touch-pad: true;
    // The graphics enhancements, each on or off.
    in property <bool> sharp-text;
    in property <bool> sharp-hud;
    in property <bool> smooth-motion;
    in property <bool> fill-window;
    in property <bool> hd-chip-art;
    in property <int> music;
    in property <int> effects;
    in property <int> input-delay;
    in property <string> signaling-server;
    in property <string> default-signaling-server;
    in property <bool> auto-upload-replays;
    // Each action's key and pad button, by their names, in the actions' order.
    in property <[string]> keys;
    in property <[PadBinding]> buttons;
    // The action whose key (or pad button) is being asked for, or -1.
    in property <int> asking-key: -1;
    in property <int> asking-button: -1;
    in property <string> data-folder;
    in property <bool> can-send-nearby;
    in property <string> nearby-target;
    // About is shown in the page's place.
    in property <bool> about;
    // Mobile virtual touch pad layout editor is shown in the page's place.
    in property <bool> touch-editor;
    in property <int> touch-selected: 0;
    callback touch-select(int);
    callback touch-move(bool, int, float, float);
    callback touch-scale(bool, int, float);
    callback touch-reset(bool);
    callback touch-commit();
    callback touch-close();
    // The picture size that isn't a number, as the list of sizes says it.
    out property <string> largest: @tr("Largest that fits");
    out property <string> update-checking-note: @tr("Checking for updates");
    out property <string> update-latest-note: @tr("You're on the latest version.");
    out property <string> update-failed-note: @tr("Couldn't check for updates.");
}

// A row's label and its note. The row's control is put beside it (at `SettingsScreen.control-x`, in a column
// `control-width` wide), not inside it: a component with something inside it is copied into each user.
component SettingLabel inherits Rectangle {
    in property <string> label;
    in property <string> note;
    // The note is a path or a name the app gives, not a sentence: one line, cut where it ends.
    in property <bool> cut;
    in property <length> row-height: 48px;
    in property <length> control-x;
    in property <length> control-width;
    property <bool> over: Theme.audit && (Theme.handheld ? name.preferred-height > name.height + 0.5px : name.preferred-width > name.width + 0.5px);
    height: root.row-height + (Theme.handheld && root.note != "" ? below.preferred-height + 4px : 0px);
    name := Text {
        x: 0;
        y: 0;
        width: root.control-x - 12px;
        height: root.row-height;
        text: root.label;
        color: Theme.text;
        font-family: Theme.body;
        font-size: 14px;
        font-weight: 600;
        vertical-alignment: center;
        wrap: Theme.handheld ? word-wrap : no-wrap;
        overflow: Theme.handheld ? clip : elide;
    }

    Note {
        x: 568px;
        y: 0;
        width: max(0px, parent.width - 568px);
        height: root.row-height;
        text: Theme.handheld ? "" : root.note;
        wrap: root.cut ? no-wrap : word-wrap;
        overflow: root.cut ? elide : clip;
    }

    below := Note {
        x: root.control-x;
        y: root.row-height;
        width: root.control-width;
        height: self.preferred-height;
        text: Theme.handheld ? root.note : "";
        wrap: root.cut ? no-wrap : word-wrap;
        overflow: root.cut ? elide : clip;
    }

    changed over => {
        if over {
            Audit.clipped(root.label);
        }
    }
}

// A part of a group, under a title smaller than the group's and with no rule (Video's graphics enhancements).
component SubTitle inherits Rectangle {
    in property <string> text;
    height: 30px;
    Label {
        x: 0;
        y: 10px;
        width: parent.width;
        height: 20px;
        text: root.text;
        font-size: 12px;
    }
}

// A key's or a pad button's box in the controls: Enter, then the key to bind.
export component BindBox inherits Rectangle {
    in property <string> nav;
    in property <int> nav-index;
    in property <string> value;
    // A pad's face button, drawn in place of the value.
    in property <PadButton> face;
    in property <bool> asking;
    in property <string> ask;
    height: 40px;
    Rectangle {
        background: Theme.inset;
        border-width: 1px;
        border-color: root.asking ? Theme.cursor : (hit.has-hover ? Theme.muted : Theme.line);
    }

    Mono {
        x: 8px;
        width: parent.width - 16px;
        text: root.asking ? root.ask : (root.face == PadButton.none ? root.value : "");
        color: root.asking ? Theme.cursor : Theme.text;
        font-family: root.asking ? Theme.body : Theme.mono;
        font-weight: root.asking ? 400 : 700;
        horizontal-alignment: center;
    }

    FaceButton {
        visible: !root.asking && root.face != PadButton.none;
        button: root.face;
    }

    // (A phone's tap reaches past it to 44 tall.)
    Reach {
        box-width: root.width;
        box-height: root.height;
        nav: root.nav;
        nav-index: root.nav-index;
    }

    hit := Focusable {
        nav: root.nav;
        nav-index: root.nav-index;
    }
}

component SettingsPage inherits Page {
    property <[string]> groups: [@tr("General"), @tr("Video"), @tr("Audio"), @tr("Online"), @tr("Controls"), @tr("About")];
    // (A pad's A and B are the menus' confirm and back too: they say so. The keyboard's are Enter and Esc.)
    property <[string]> actions: [@tr("Up"), @tr("Down"), @tr("Left"), @tr("Right"), @tr("A · Pad confirms"), @tr("B · Pad goes back"), "L", "R", "START", "SELECT", @tr("Navi change left"), @tr("Navi change right")];
    // (A phone has the page alone.)
    property <[string]> shown-groups: Theme.phone ? [] : root.groups;
    property <length> list-width: Theme.phone ? 0px : Theme.sideways ? 172px : 260px;
    // (The groups' rows: the list's width less the gap to the page.)
    property <length> group-width: root.list-width - (Theme.sideways ? 12px : 40px);
    // Where a row's control is, and how wide its column.
    property <length> control-x: Theme.phone ? 124px : Theme.sideways ? 170px : 224px;
    property <length> control-width: Theme.phone ? page.view-width - 124px : Theme.sideways ? min(260px, page.view-width - 170px) : 320px;
    title: I18n.upper(@tr("Settings"));
    back: I18n.upper(@tr("Menu"));
    game: false;
    hints: [
        { key: "↑↓", pad: PadButton.move, text: @tr("Move") },
        { key: Shell.key-a, pad: Shell.pad-a, text: @tr("Choose") },
        { key: Shell.key-b, pad: Shell.pad-b, text: @tr("Back") },
        { key: "Tab", text: @tr("Next") },
    ];

    // The groups: the mark of the one the focus is in slides between them.
    Arrive {
        order: 0;
        Marker {
            x: 0;
            y: SettingsView.group * (Theme.row + 2px);
            width: root.group-width;
            height: Theme.row;
            visible: !Theme.phone;
            animate y {
                duration: Theme.quick;
                easing: ease-out;
            }

            Rectangle { }  // (Copied in: docs/app.md §14.)
        }

        for group[i] in root.shown-groups: Row {
            x: 0;
            y: i * (Theme.row + 2px);
            width: root.group-width;
            nav: "group";
            nav-index: i;
            text: group;

            Rectangle { }  // (Copied in: docs/app.md §14.)
        }
    }

    Arrive {
        order: 1;
        page := ScrollPage {
            x: root.list-width;
            width: root.body-width - root.list-width;
            nav: "set.";
            content-height: column.preferred-height;
            user-scrolled => {
                SettingsView.scrolled(
                    self.scroll,
                    self.height,
                    column.preferred-height,
                    [g-general.y, g-video.y, g-audio.y, g-online.y, g-controls.y, g-about.y],
                );
            }
            column := VerticalLayout {
                width: page.view-width;
                spacing: 4px;
                alignment: start;
                g-general := GroupTitle {
                    text: I18n.upper(@tr("General"));
                    first: true;
                }

                Rectangle {
                    height: row1.height;
                    row1 := SettingLabel {
                        label: @tr("Name");
                        note: @tr("Shown to your opponent.");
                        control-x: root.control-x;
                        control-width: root.control-width;
                    }

                    Field {
                        x: root.control-x;
                        y: 4px;
                        width: root.control-width;
                        nav: "set.name";
                        text: SettingsView.name;
                    }
                }

                Rectangle {
                    height: row2.height;
                    row2 := SettingLabel {
                        label: @tr("Language");
                        control-x: root.control-x;
                        control-width: root.control-width;
                    }

                    Select {
                        x: root.control-x;
                        y: 4px;
                        width: root.control-width;
                        nav: "set.language";
                        value: SettingsView.language;
                    }
                }

                Rectangle {
                    height: row16.height;
                    row16 := SettingLabel {
                        label: @tr("Check for updates");
                        control-x: root.control-x;
                        control-width: root.control-width;
                    }

                    Seg {
                        x: root.control-x;
                        y: 6px;
                        nav: "set.updates";
                        first: I18n.upper(@tr("Off"));
                        second: I18n.upper(@tr("On"));
                        chosen: SettingsView.check-updates ? 1 : 0;
                    }
                }

                if SettingsView.can-update: Rectangle {
                    height: check-now-row.height;
                    check-now-row := SettingLabel {
                        note: SettingsView.update-note;
                        control-x: root.control-x;
                        control-width: root.control-width;
                    }

                    Button {
                        x: root.control-x;
                        y: 4px;
                        nav: "set.check-now";
                        text: I18n.upper(@tr("Check now"));
                    }
                }

                g-video := GroupTitle {
                    text: I18n.upper(@tr("Video"));
                }

                Rectangle {
                    height: row3.height;
                    row3 := SettingLabel {
                        label: @tr("Picture size");
                        control-x: root.control-x;
                        control-width: root.control-width;
                    }

                    Select {
                        x: root.control-x;
                        y: 4px;
                        width: root.control-width;
                        nav: "set.picture";
                        value: SettingsView.picture-size == "" ? SettingsView.largest : SettingsView.picture-size;
                    }
                }

                Rectangle {
                    height: row4.height;
                    row4 := SettingLabel {
                        label: @tr("Full screen");
                        control-x: root.control-x;
                        control-width: root.control-width;
                    }

                    Seg {
                        x: root.control-x;
                        y: 6px;
                        nav: "set.fullscreen";
                        first: I18n.upper(@tr("Off"));
                        second: I18n.upper(@tr("On"));
                        chosen: SettingsView.full-screen ? 1 : 0;
                    }
                }

                if SettingsView.is-android: Rectangle {
                    height: status-bar-row.height;
                    status-bar-row := SettingLabel {
                        label: @tr("Hide status bar in landscape");
                        note: @tr("Hide Android's top status bar while holding the phone sideways.");
                        control-x: root.control-x;
                        control-width: root.control-width;
                    }

                    Seg {
                        x: root.control-x;
                        y: 6px;
                        nav: "set.status-bar";
                        first: I18n.upper(@tr("Off"));
                        second: I18n.upper(@tr("On"));
                        chosen: SettingsView.hide-landscape-status-bar ? 1 : 0;
                    }
                }

                Rectangle {
                    height: row14.height;
                    row14 := SettingLabel {
                        label: @tr("Reduce motion");
                        control-x: root.control-x;
                        control-width: root.control-width;
                    }

                    Seg {
                        x: root.control-x;
                        y: 6px;
                        nav: "set.motion";
                        first: I18n.upper(@tr("Off"));
                        second: I18n.upper(@tr("On"));
                        chosen: SettingsView.reduce-motion ? 1 : 0;
                    }
                }

                Rectangle {
                    height: flashes-row.height;
                    flashes-row := SettingLabel {
                        label: @tr("Reduce flashes");
                        note: @tr("Soften sudden white-screen flashes in battle.");
                        control-x: root.control-x;
                        control-width: root.control-width;
                    }

                    Seg {
                        x: root.control-x;
                        y: 6px;
                        nav: "set.reduce-flashes";
                        first: I18n.upper(@tr("Off"));
                        second: I18n.upper(@tr("On"));
                        chosen: SettingsView.reduce-flashes ? 1 : 0;
                    }
                }

                Rectangle {
                    height: aura-number-row.height;
                    aura-number-row := SettingLabel {
                        label: @tr("Hide aura number");
                        note: @tr("Hide the 200 number on LifeAura.");
                        control-x: root.control-x;
                        control-width: root.control-width;
                    }

                    Seg {
                        x: root.control-x;
                        y: 6px;
                        nav: "set.hide-aura-number";
                        first: I18n.upper(@tr("Off"));
                        second: I18n.upper(@tr("On"));
                        chosen: SettingsView.hide-aura-number ? 1 : 0;
                    }
                }

                // (Video's graphics enhancements: a part of the group, under a title of their own.)
                SubTitle {
                    text: @tr("Graphics enhancements");
                }

                Rectangle {
                    height: row5.height;
                    row5 := SettingLabel {
                        label: @tr("Sharp text");
                        note: @tr("Chip names and messages drawn at full resolution.");
                        control-x: root.control-x;
                        control-width: root.control-width;
                    }

                    Seg {
                        x: root.control-x;
                        y: 6px;
                        nav: "set.text";
                        first: I18n.upper(@tr("Off"));
                        second: I18n.upper(@tr("On"));
                        chosen: SettingsView.sharp-text ? 1 : 0;
                    }
                }

                Rectangle {
                    height: row17.height;
                    row17 := SettingLabel {
                        label: @tr("Sharp HUD");
                        note: @tr("Frames, banners and numbers redrawn at full resolution.");
                        control-x: root.control-x;
                        control-width: root.control-width;
                    }

                    Seg {
                        x: root.control-x;
                        y: 6px;
                        nav: "set.hud";
                        first: I18n.upper(@tr("Off"));
                        second: I18n.upper(@tr("On"));
                        chosen: SettingsView.sharp-hud ? 1 : 0;
                    }
                }

                Rectangle {
                    height: row18.height;
                    row18 := SettingLabel {
                        label: @tr("Smooth motion");
                        note: @tr("Scrolling, gauges and banners move between the game's pixels.");
                        control-x: root.control-x;
                        control-width: root.control-width;
                    }

                    Seg {
                        x: root.control-x;
                        y: 6px;
                        nav: "set.smooth";
                        first: I18n.upper(@tr("Off"));
                        second: I18n.upper(@tr("On"));
                        chosen: SettingsView.smooth-motion ? 1 : 0;
                    }
                }

                Rectangle {
                    height: row19.height;
                    row19 := SettingLabel {
                        label: @tr("Fill the window");
                        note: @tr("The stage reaches the window's edges, the HUD with it.");
                        control-x: root.control-x;
                        control-width: root.control-width;
                    }

                    Seg {
                        x: root.control-x;
                        y: 6px;
                        nav: "set.fill";
                        first: I18n.upper(@tr("Off"));
                        second: I18n.upper(@tr("On"));
                        chosen: SettingsView.fill-window ? 1 : 0;
                    }
                }

                Rectangle {
                    height: hd-art-row.height;
                    hd-art-row := SettingLabel {
                        label: @tr("HD chip art");
                        note: @tr("Use Legacy Collection high-resolution chip artwork when available.");
                        control-x: root.control-x;
                        control-width: root.control-width;
                    }

                    Seg {
                        x: root.control-x;
                        y: 6px;
                        nav: "set.hd-chip-art";
                        first: I18n.upper(@tr("Off"));
                        second: I18n.upper(@tr("On"));
                        chosen: SettingsView.hd-chip-art ? 1 : 0;
                    }
                }

                g-audio := GroupTitle {
                    text: I18n.upper(@tr("Audio"));
                }

                Rectangle {
                    height: row6.height;
                    row6 := SettingLabel {
                        label: @tr("Music");
                        control-x: root.control-x;
                        control-width: root.control-width;
                    }

                    Slider {
                        x: root.control-x;
                        y: 4px;
                        width: root.control-width;
                        nav: "set.music";
                        value: SettingsView.music;
                    }
                }

                Rectangle {
                    height: row7.height;
                    row7 := SettingLabel {
                        label: @tr("Sound effects");
                        control-x: root.control-x;
                        control-width: root.control-width;
                    }

                    Slider {
                        x: root.control-x;
                        y: 4px;
                        width: root.control-width;
                        nav: "set.effects";
                        value: SettingsView.effects;
                    }
                }

                g-online := GroupTitle {
                    text: I18n.upper(@tr("Online"));
                }

                Rectangle {
                    height: row8.height;
                    row8 := SettingLabel {
                        label: @tr("Input delay");
                        note: @tr("In frames. Lower feels faster; higher rolls back less.");
                        control-x: root.control-x;
                        control-width: root.control-width;
                    }

                    Stepper {
                        x: root.control-x;
                        y: 6px;
                        nav: "set.delay";
                        value: SettingsView.input-delay;
                        value-width: 48px;
                        numeric: true;
                    }
                }

                Rectangle {
                    height: row20.height;
                    row20 := SettingLabel {
                        label: @tr("Signaling server");
                        note: @tr("Leave blank for the default server. Include ws:// or wss://.");
                        control-x: root.control-x;
                        control-width: root.control-width;
                    }

                    Field {
                        x: root.control-x;
                        y: 4px;
                        width: root.control-width;
                        nav: "set.server";
                        text: SettingsView.signaling-server;
                        placeholder: SettingsView.default-signaling-server;
                    }
                }

                Rectangle {
                    height: row-auto-upload.height;
                    row-auto-upload := SettingLabel {
                        label: @tr("Auto-upload replays");
                        note: @tr("Automatically upload finished online replays to the server's Recent Replays feed. Off by default.");
                        control-x: root.control-x;
                        control-width: root.control-width;
                    }

                    Seg {
                        x: root.control-x;
                        y: 6px;
                        nav: "set.auto-upload";
                        first: I18n.upper(@tr("Off"));
                        second: I18n.upper(@tr("On"));
                        chosen: SettingsView.auto-upload-replays ? 1 : 0;
                    }
                }

                g-controls := GroupTitle {
                    text: I18n.upper(@tr("Controls"));
                }

                Rectangle {
                    height: row9.height;
                    row9 := SettingLabel {
                        row-height: 24px;
                        control-x: root.control-x;
                        control-width: root.control-width;
                    }

                    Label {
                        x: root.control-x;
                        width: (root.control-width - 24px) / 2;
                        text: I18n.upper(@tr("Key"));
                    }

                    Label {
                        x: root.control-x + (root.control-width + 24px) / 2;
                        width: (root.control-width - 24px) / 2;
                        text: I18n.upper(@tr("Pad"));
                    }
                }

                for action[i] in root.actions: Rectangle {
                    height: row10.height;
                    row10 := SettingLabel {
                        label: action;
                        control-x: root.control-x;
                        control-width: root.control-width;
                    }

                    BindBox {
                        x: root.control-x;
                        y: 4px;
                        width: (root.control-width - 24px) / 2;
                        nav: "set.key";
                        nav-index: i;
                        value: SettingsView.keys[i];
                        asking: SettingsView.asking-key == i;
                        ask: @tr("Key or click");
                    }

                    BindBox {
                        x: root.control-x + (root.control-width + 24px) / 2;
                        y: 4px;
                        width: (root.control-width - 24px) / 2;
                        nav: "set.button";
                        nav-index: i;
                        value: SettingsView.buttons[i].text;
                        face: SettingsView.buttons[i].face;
                        asking: SettingsView.asking-button == i;
                        ask: @tr("Press a button");
                    }
                }

                Rectangle {
                    height: row11.height;
                    row11 := SettingLabel {
                        control-x: root.control-x;
                        control-width: root.control-width;
                    }

                    Button {
                        x: root.control-x;
                        y: 4px;
                        nav: "set.reset";
                        text: I18n.upper(@tr("Reset controls"));
                    }
                }

                Rectangle {
                    height: keyboard-only-row.height;
                    keyboard-only-row := SettingLabel {
                        label: @tr("Keyboard-only custom screen");
                        note: @tr("Disable mouse and touch chip selection on the custom screen.");
                        control-x: root.control-x;
                        control-width: root.control-width;
                    }

                    Seg {
                        x: root.control-x;
                        y: 6px;
                        nav: "set.keyboard-only";
                        first: I18n.upper(@tr("Off"));
                        second: I18n.upper(@tr("On"));
                        chosen: SettingsView.keyboard-only-custom ? 1 : 0;
                    }
                }

                if Theme.phone-app: Rectangle {
                    height: landscape-pad-row.height;
                    landscape-pad-row := SettingLabel {
                        label: @tr("Landscape touch pad");
                        note: @tr("Show on-screen controls in landscape.");
                        control-x: root.control-x;
                        control-width: root.control-width;
                    }

                    Seg {
                        x: root.control-x;
                        y: 6px;
                        nav: "set.landscape-pad";
                        first: I18n.upper(@tr("Off"));
                        second: I18n.upper(@tr("On"));
                        chosen: SettingsView.landscape-touch-pad ? 1 : 0;
                    }
                }

                if Theme.phone-app || Theme.phone: Rectangle {
                    height: touch-layout-row.height;
                    touch-layout-row := SettingLabel {
                        label: @tr("Touch pad layout");
                        note: @tr("Customize button positions and sizes.");
                        control-x: root.control-x;
                        control-width: root.control-width;
                    }

                    Button {
                        x: root.control-x;
                        y: 4px;
                        nav: "set.touch-layout";
                        text: I18n.upper(@tr("Customize"));
                    }
                }

                g-about := GroupTitle {
                    text: I18n.upper(@tr("About"));
                }

                Rectangle {
                    height: row12.height;
                    row12 := SettingLabel {
                        label: @tr("Version");
                        control-x: root.control-x;
                        control-width: root.control-width;
                    }

                    Mono {
                        x: root.control-x;
                        y: 0;
                        width: root.control-width;
                        height: 48px;
                        text: Shell.version;
                    }
                }

                Rectangle {
                    height: row13.height;
                    row13 := SettingLabel {
                        label: @tr("Your files");
                        note: SettingsView.data-folder;
                        cut: true;
                        control-x: root.control-x;
                        control-width: root.control-width;
                    }

                    Button {
                        x: root.control-x;
                        y: 4px;
                        nav: "set.folder";
                        text: I18n.upper(@tr("Show folder"));
                    }
                }

                if SettingsView.can-send-nearby: Rectangle {
                    height: row21.height;
                    row21 := SettingLabel {
                        label: @tr("Send to phone");
                        note: @tr("Enter the address shown on the phone to send the Legacy Collection over Wi-Fi.");
                        control-x: root.control-x;
                        control-width: root.control-width;
                    }

                    Field {
                        x: root.control-x;
                        y: 4px;
                        width: root.control-width - send-btn.width - 8px;
                        nav: "set.nearby";
                        text: SettingsView.nearby-target;
                        placeholder: "192.168.1.25:54321";
                    }

                    send-btn := Button {
                        x: root.control-x + root.control-width - self.width;
                        y: 4px;
                        nav: "set.nearby.send";
                        text: I18n.upper(NearbyWords.send);
                    }
                }

                Rectangle {
                    height: row15.height;
                    row15 := SettingLabel {
                        label: @tr("Made with");
                        control-x: root.control-x;
                        control-width: root.control-width;
                    }

                    Button {
                        x: root.control-x;
                        y: 4px;
                        nav: "set.about";
                        text: I18n.upper(@tr("Show licenses"));
                    }
                }

                Rectangle {
                    height: 24px;
                }
            }
        }
    }
}

// Settings, About, or the Touch Pad layout editor in their place.
export component SettingsScreen inherits Rectangle {
    if !SettingsView.about && !SettingsView.touch-editor: SettingsPage {
        Rectangle { }  // (Copied in: docs/app.md §14.)
    }
    if SettingsView.about: AboutPage {
        Rectangle { }  // (Copied in: docs/app.md §14.)
    }
    if SettingsView.touch-editor && !SettingsView.about: TouchLayoutEditor {
        width: parent.width;
        height: parent.height;
        selected: SettingsView.touch-selected;
        select(i) => {
            SettingsView.touch-select(i);
        }
        move(landscape, i, dx, dy) => {
            SettingsView.touch-move(landscape, i, dx, dy);
        }
        scale-by(landscape, i, delta) => {
            SettingsView.touch-scale(landscape, i, delta);
        }
        reset(landscape) => {
            SettingsView.touch-reset(landscape);
        }
        commit => {
            SettingsView.touch-commit();
        }
        close => {
            SettingsView.touch-close();
        }
    }
}

// What opens over Settings: About's sheet, on a phone.
export component SettingsOverlay inherits Rectangle {
    AboutOverlay {
        Rectangle { }  // (Copied in: docs/app.md §14.)
    }
}
