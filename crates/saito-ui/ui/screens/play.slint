// Play (docs/design/app-ui.md §6: "Play", "In an online match", "After a match"): online play. Its Rust half
// is src/screens/play.rs, which sets `PlayView` and hears the controls by their names.
//
// The screen has two parts, one shown at a time (`PlayView.part`): the player's builds (+ NEW BUILD over them,
// the chosen one's overview beside them with PRACTICE, EDIT and ⋯, its menu of DUPLICATE and DELETE) with
// the ways to play it online under them (HOST: an invite; JOIN: an invite's code typed; DIRECT CONNECT: a direct
// connection's dialog); and the lobby, from the moment an invite is out (or this machine hosts) for as long as the
// two players stay together: while the host waits for the other player (`PlayView.waiting`) the other player's
// place has the invite's code and a practice battle is in the player's own, and the match's settings are already
// the host's to set (the user: "the host should be able to change settings before the joiner joins. you should
// unify the interface somehow between the waiting and the lobby"). The two cards
// before a match and the match itself are the shell's (versus.slint, battle.slint); over the match are this
// file's menu (`MatchMenu`), the two builds shown while Tab is held (`MatchPeek`), and how the match went once its
// set is over (`MatchResult`).

import { Theme, Audit, I18n } from "../theme.slint";
import { Nav, NavKind, Focusable } from "../nav.slint";
import { Shell, Page, PadButton, Hint, Picture, DialogFrame, FaceButton } from "../shell.slint";
import { Cut, Label, Note, Message, Value, Mono, Pill, Button, ButtonKind, Field, Stepper, Seg, Select, Slider, MenuItem, RowBack, RowTouch, ListView, ScrollPage, PanelBack, Rule, Bars, ArrowDown, ProblemMark } from "../widgets.slint";
import { MenuOverlay } from "battle.slint";
import { SettingsView, BindBox } from "settings.slint";
import { Arrive, Tween, Pulse, Flash, Count } from "../motion.slint";
import { VersionTag, BuildEntry, BuildSheet, BuildRow, BuildOverview, RulesetNote, ChipRow } from "../build.slint";
import { CsProbDialog, CsProbEntry } from "../cs_prob.slint";
import { AbdGuideDialog } from "../abd_guide.slint";

// The part of Play shown.
export enum PlayPart {
    // The builds, what is done with them, and the row that makes a link.
    builds,
    // The lobby: an invite is out, or this machine hosts (`PlayView.waiting`), or the two players are together.
    lobby,
    // Watching another room live (lobby waiting or active battle).
    spectate,
}

// One public room in the unified room list browser.
export struct RoomEntry {
    code: string,
    game: string,
    same-game: bool,
    host: string,
    players: string,
    rules: string,
    // 0 = waiting for opponent (1/2, joinable), 1 = full lobby (2/2), 2 = loading, 3 = playing
    stage: int,
    joinable: bool,
    spectators: int,
    delay: int,
}

// A dialog of the builds' part: a new build's name and version.
export enum BuildDialog {
    none,
    new-build,
}

// What the lobby's reserved line says.
export enum LobbyNote {
    none,
    // The other player is ready and this one isn't; the other way about.
    you,
    them,
    // The link is down and being made again (`PlayView.note-seconds` left).
    reconnecting,
    // This player's build can't be played as the match's settings stand (with Patch cards off, its cards
    // left out): READY is refused.
    unusable,
}

// How a match's set went for this player, for its result (`MatchResult`).
export enum MatchOutcome {
    won,
    lost,
    drawn,
}

// A page of the match menu.
export enum MatchPage {
    menu,
    controls,
    settings,
}

// This player's build as the lobby's card names it (as the match's settings would play it): its name and its navi.
export struct PlayBuild {
    name: string,
    navi: string,
}

// An action of the battle with what is bound to it: a key's cap; a pad's face button, drawn by its place, or a
// button's cap.
export struct PlayControl {
    key: string,
    face: PadButton,
    pad: string,
}

// Per-round Stage & BGM entry shown in the online lobby's Custom configuration dialog.
export struct StageRoundEntry {
    bg: string,
    bgm: string,
}

// What Play shows: src/screens/play.rs sets these. (A struct or an enum a property here uses reaches Rust by
// that use: nothing is added to app.slint for it.)
export global PlayView {
    in property <PlayPart> part;

    // ---- The builds --------------------------------------------------------------------------------------
    // The selected game's builds, and the one chosen (the one a link brings and the one EDIT, DUPLICATE and
    // DELETE act on): its row, and its overview. A build whose file doesn't read as one (not `readable`)
    // can only be deleted.
    in property <[BuildEntry]> builds;
    in property <int> chosen;
    in property <BuildEntry> build;
    in property <BuildSheet> sheet;
    in property <bool> readable;
    // How far the overview's column is scrolled (0 or less), how far it can be, and how tall its frame is: the wheel
    // and a drag over it scroll it, and the app by the right stick and Shift's scrolls (`Play::scroll_view`).
    in-out property <length> sheet-y;
    in-out property <length> sheet-span;
    in-out property <length> sheet-view;
    // A dialog for a build's name: a new build's, with its version, or the chosen build's new name. The game's
    // versions, in its own order, and the one chosen; what a version sets, in the game's words.
    in property <BuildDialog> dialog;
    in property <string> dialog-name;
    in property <[VersionTag]> versions;
    in property <int> dialog-version;
    in property <string> version-sets;
    // What the reserved line under the online row says (`PlayPart.builds`).
    in property <string> message;
    in property <bool> message-quiet;
    // What it says is why the chosen build can't be played (its problems, docs/design/app-ui.md §2.66): the problem's
    // mark before it, and the control isn't marked.
    in property <bool> message-problem;

    // The code a box a character, where it can't be typed (a pad): open, and its six characters. `code-set` is
    // how many characters a code is written in.
    in property <bool> boxes;
    in property <[string]> box-characters;
    in property <int> code-set;

    // ---- A direct connection -----------------------------------------------------------------------------
    in property <bool> direct;
    // This machine's address, for the other player; the address typed.
    in property <string> host-address;
    in property <string> address;
    // What went wrong with hosting (in place of the line under the address), and with joining.
    in property <string> host-message;
    in property <string> join-message;
    in property <bool> join-quiet;
    // It counts the copies: what was copied flashes.
    in property <int> copied-seq;

    // ---- Waiting -----------------------------------------------------------------------------------------
    // The lobby has nobody else yet: an invite is out, or this machine hosts. What the other player needs: the
    // invite's code in threes, or a direct host's address.
    in property <bool> waiting;
    in property <string> invite;
    in property <bool> invite-direct;

    // ---- The lobby ---------------------------------------------------------------------------------------
    in property <string> their-name;
    // The other player's lobby was heard: their card is there.
    in property <bool> their-present;
    in property <bool> ready;
    in property <bool> their-ready;
    // This player's card: the build as the match's settings would play it.
    in property <PlayBuild> card;
    // They count the times each turned ready: the mark stamps.
    in property <int> ready-seq;
    in property <int> their-ready-seq;
    // The match's settings, both players' and the host's alone to change (`host`; the joiner's controls are
    // unavailable): the round wins its set is first to (1: a single battle; 2: the original's triple battle,
    // best of 3), the ruleset by its name, open setups (each player may see the other's build in the match),
    // and the custom screen's time limit in seconds (0: none; saito's own).
    in property <int> first-to: 2;
    in property <string> ruleset;
    // Tiered built-in ruleset toggles: Level 2 (`ruleset-sub-kind`: 0 = none, 1 = EXE5 5DS, 2 = EXE5 Gate Solo/Party)
    // and Level 3 (`ruleset-mixed`: Single vs Mixed versions). Hidden for custom/host-only rulesets.
    in property <bool> ruleset-tiered: false;
    in property <int> ruleset-sub-kind: 0;
    in property <bool> ruleset-sub: false;
    in property <bool> ruleset-mixed: false;
    in property <bool> host;
    in property <bool> open;
    in property <int> custom-time: 60;
    // The player's own, apart from the match's (the user: "the input delay and ping settings should probably be
    // displayed separately from the lobby settings, since those are client-local things").
    in property <int> input-delay;
    // The connection: its bars (0 to 4) and the round trip in ms (-1: not measured).
    in property <int> bars;
    in property <int> ping: -1;
    in property <LobbyNote> note;
    in property <int> note-seconds;
    // What is wrong with the build, where the settings can't play it (`LobbyNote.unusable`): its sentence.
    in property <string> note-problem;
    // Why the match before ended, where it didn't end by itself (in the error red, in the note's place).
    in property <string> note-error;
    // Another build is being chosen.
    in property <bool> changing;
    // Client-local Stage & BGM mode (0 = Default, 1 = Full random, 2 = Escalating, 3 = Custom) and dialog state.
    in property <int> stage-mode: 0;
    in property <bool> stage-dialog;
    in property <[StageRoundEntry]> stage-rounds;
    // Official EXE6 Random Battle mode (0 = Off, 1 = Rank 1, 2 = Rank 2, 3 = Rank 3).
    in property <bool> random-supported: false;
    in property <int> random-rank: 0;
    // EXE6 Random Battle pre-battle prep dialog (stats confirmation, 30-chip folder check, Regular 30MB / Tag 60MB).
    in property <bool> random-prep: false;
    in property <int> prep-rank: 1;
    in property <BuildSheet> prep-sheet;
    in property <int> prep-slot: 0;
    in property <int> prep-reg-mb: 0;
    in property <int> prep-tag-mb: 0;
    in property <bool> prep-tagging: false;
    in property <string> prep-notice;
    in property <bool> prep-ready: false;
    in property <bool> prep-their-ready: false;
    in property <string> prep-detail;
    // EXE4 / EXE5 Dark Soul AI (ABD) mode (0 = Original, 1 = Legacy Collection, 2 = DS), per-round high-class chip cap (0 = Off), and guide dialog.
    in property <bool> abd-supported: false;
    in property <bool> abd-has-ds: false;
    in property <int> abd-mode: 0;
    in property <int> abd-chip-cap: 0;
    in property <bool> abd-guide-dialog: false;
    pure public function abd-cap-choice(cap: int) -> string {
        if cap <= 0 {
            return @tr("Off");
        }
        if cap == 3 {
            return @tr("{} (Official)", cap);
        }
        if cap == 5 {
            return @tr("{} (Default)", cap);
        }
        return "\{cap}";
    }
    // EXE5 / EXE6 per-effect ChargeShot Addition probability fix settings and dialog state.
    in property <bool> cs-prob-supported: false;
    in property <int> cs-prob-count: 0;
    in property <int> cs-prob-total: 0;
    in property <bool> cs-prob-recommended: false;
    in property <bool> cs-prob-dialog: false;
    in property <[CsProbEntry]> cs-prob-items;
    // EXE4 Legacy Collection All Guard patch card restriction (true = Off / LC, false = On / Original).
    in property <bool> all-guard-supported: false;
    in property <bool> all-guard-disabled: true;
    // EXE5 Legacy Collection Light MegaMan dimming dark chip cut-in fix (true = LC, false = Original).
    in property <bool> dark-cut-in-supported: false;
    in property <bool> dark-cut-in-fix: true;
    // EXE5 outdoor sunlight state (true = Outdoor/Sunny default, false = Indoor/Shade).
    in property <bool> ds-sun-supported: false;
    in property <bool> sun-enabled: true;
    // EXE5DS Shout volume mode (only shown for 5DS rulesets): false = Real 3-Tier, true = Always Max.
    in property <bool> ds-shout-supported: false;
    in property <bool> ds-shout-max-only: false;

    // ---- Spectator mode (host settings, browser dialog, active watch) -----------------------------------
    // Host's spectator visibility (0 = off, 1 = code-only, 2 = public) and anti-ghosting delay (seconds).
    in property <int> spectate-visibility: 1;
    in property <int> spectate-delay: 0;
    in property <int> spectators: 0;
    // Unified room list dialog (enter a code to join/watch, or browse public rooms).
    in property <bool> room-browser;
    in property <[RoomEntry]> room-entries;
    in property <bool> room-loading;
    in property <bool> room-filter-current;
    in property <string> room-code;
    in property <string> room-error;
    in property <bool> room-quiet;
    // Active spectator session (`PlayPart.spectate`).
    in property <string> watch-code;
    in property <string> watch-game;
    in property <string> watch-players;
    in property <string> watch-stage;
    in property <int> watch-spectators;
    in property <int> watch-delay;
    in property <bool> watch-in-battle;
    in property <bool> watch-catching-up;
    // 0 = P1, 1 = P2, 2 = Both consoles.
    in property <int> watch-view;
    in property <string> watch-problem;
    in property <bool> watch-menu;

    // ---- In a match --------------------------------------------------------------------------------------
    in property <MatchPage> page;
    // The builds are shown (Tab, or Select on a pad, is held).
    in property <bool> peek;
    // How far the builds shown are scrolled (0 or less: both by the same, each no further than its own end), how far
    // they can be (the longer's), and how tall the shorter's box is: the keys and the pad scroll them from the app
    // while the menu is open (`Play::scroll`), the wheel and a drag over them here.
    in-out property <length> peek-y;
    in-out property <length> peek-span;
    in-out property <length> peek-view;
    // The match's own controls as this player's bindings have them, for the match menu's footer: moving (the four
    // directions' keys), A, B, L and R (one hint where the pad's are the shoulders), showing the builds (Tab, the
    // pad's button bound to SELECT) and the menu (Esc, and the key and the pad's button bound to START).
    in property <[Hint]> match-keys;
    // The match's setups are open: the other player's build may be shown.
    in property <bool> open-match;
    // The two builds as the match plays them, each a player's panel.
    in property <BuildSheet> mine;
    in property <BuildSheet> theirs;
    in property <[PlayControl]> controls;
    in property <int> music;
    in property <int> effects;

    // ---- After a match -----------------------------------------------------------------------------------
    // The set is over: how it went for this player, over the picture until they go on (`MatchResult`). Its
    // facts: the round wins each side has, this player's first, and the match's time in hundredths of a second.
    in property <bool> result-shown;
    in property <MatchOutcome> outcome;
    in property <int> result-wins;
    in property <int> result-losses;
    in property <int> result-time;
    // A press settles it: everything at its end at once.
    in property <bool> result-settled;
    // For its sounds (the app's): it counts the numbers shown as they tick, and says when the last has come to
    // its value. The app puts them back as it shows a result.
    in-out property <int> result-ticks;
    in-out property <bool> result-done;
    // Post-match ABD Mega/Giga/Dark/PA chip usage summary (empty when no ABD high-class chip was used).
    in property <string> result-abd-header;
    in property <[string]> result-abd-lines;

    // ---- Words the app needs -----------------------------------------------------------------------------
    out property <string> you: I18n.upper(@tr("You"));
    out property <string> opponent: I18n.upper(@tr("Opponent"));
    out property <string> back-to-play: I18n.upper(@tr("Back to play"));
    // Esc in the lobby asks before the other player is left.
    out property <string> leave-question: @tr("Leave the lobby?");
    out property <string> cancel-word: I18n.upper(@tr("Cancel"));
    out property <string> leave-word: I18n.upper(@tr("Leave"));
    out property <string> connecting: @tr("Connecting…");
    // The match menu's footer's words (`match-keys`).
    out property <string> move-word: @tr("Move");
    out property <string> show-builds-word: @tr("Show builds");
    out property <string> menu-word: @tr("Menu");
    out property <string> new-name: @tr("New build");
    out property <string> delete-word: I18n.upper(@tr("Delete"));
    // The build's menu (⋯, or a right click on its row), DELETE apart after them.
    out property <string> practice-word: I18n.upper(@tr("Practice"));
    out property <string> duplicate-word: I18n.upper(@tr("Duplicate"));
    out property <string> save-files: @tr("Save files");
    public pure function delete-title(name: string) -> string {
        return @tr("Delete {}?", name);
    }
    // While the other player is waited for, the practice menu's EXIT (src/screens/play.rs's `train`), with an
    // invite out or this machine hosting directly; and a phone's one row at its top.
    public pure function wait-exit(direct: bool) -> string {
        return direct ? I18n.upper(@tr("Stop hosting")) : I18n.upper(@tr("Cancel invite"));
    }
    out property <string> stop-practice: I18n.upper(@tr("Stop practice"));
    out property <string> stage-random: @tr("Random");
    out property <string> enter-room-code: @tr("Enter a room code.");
    out property <string> watch-disabled: @tr("Host disabled spectating.");
    out property <string> watch-room-closed: @tr("Host closed the room.");
    out property <string> watch-stage-lobby: @tr("Waiting in lobby…");
    out property <string> watch-stage-loading: @tr("Loading match…");
    out property <string> watch-stage-playing: @tr("Match in progress…");
    public pure function watch-game-missing(game: string) -> string {
        return @tr("{} is not installed.", game);
    }
}

// ---- The builds ------------------------------------------------------------------------------------------

// The chosen build in one box, on a phone: Enter opens the builds as a sheet, a select's list (the arrows walk past it).
component BuildBox inherits Rectangle {
    in property <BuildEntry> build;
    in property <string> nav;
    in property <bool> enabled: true;
    height: 72px;
    PanelBack { }

    Value {
        x: 16px;
        y: 14px;
        width: parent.width - 68px;
        height: 24px;
        text: root.build.name;
        font-size: 18px;
        font-weight: 900;
    }

    Text {
        x: root.build.bad ? 25px : 16px;
        y: 42px;
        width: parent.width - 68px - (root.build.bad ? 9px : 0px) - (made-for.width > 0 ? made-for.width + 12px : 0px);
        height: 16px;
        text: root.build.status;
        color: root.build.bad ? Theme.bad : Theme.muted;
        font-family: Theme.body;
        font-size: 12px;
        vertical-alignment: center;
        overflow: elide;
    }

    // (A build with problems: their mark before the words.)
    ProblemMark {
        x: 16px;
        y: 42px + 5.5px;
        visible: root.build.bad;
    }

    // (The ruleset it is made for, at the status line's right end.)
    made-for := RulesetNote {
        x: parent.width - 52px - self.width;
        y: 42px;
        build: root.build;
        room: parent.width - 68px;
    }

    ArrowDown {
        x: parent.width - 24px;
    }

    Focusable {
        nav: root.nav;
        kind: NavKind.button;
        enabled: root.enabled;
    }
}

// The chosen build on a phone held sideways (docs/design/app-ui.md §2.103), in the overview's place, which has no
// room there: its face, its name over its navi with its choices' presets, its forms, and what it holds in two lines
// (its HP, its folder's chips and the ruleset it is made for; its abilities). One that can't be read has its name and
// why, in the error red. EDIT and ⋯ are the screen's, at its top right in the room `tools` keeps for them.
component BuildCard inherits Rectangle {
    in property <BuildEntry> build;
    in property <BuildSheet> sheet;
    in property <bool> usable;
    in property <length> tools;
    property <length> pad: 14px;
    property <length> words-x: root.usable ? root.pad + 76px : root.pad;
    property <string> hp: root.sheet.stats.length == 0 ? "" : "\{@tr("HP")} \{root.sheet.stats[0].value}";
    property <string> chips: "\{@tr("Chips")} \{root.sheet.count}";
    property <string> ruleset: root.build.ruleset == "" ? "" : root.build.ruleset-missing ? @tr("{} (missing)", root.build.ruleset) : root.build.ruleset;
    PanelBack { }

    Image {
        x: root.pad;
        y: root.pad + 2px;
        width: 64px;
        height: 32px;
        visible: root.usable;
        source: root.sheet.face;
        image-rendering: pixelated;
    }

    Value {
        x: root.words-x;
        y: 12px;
        width: max(0px, parent.width - self.x - root.tools - 12px);
        height: 24px;
        text: root.build.name;
        font-size: 18px;
        font-weight: 900;
    }

    Text {
        x: root.words-x;
        y: 36px;
        width: max(0px, parent.width - self.x - root.tools - 12px);
        height: 18px;
        text: !root.usable ? root.build.status : root.sheet.presets == "" ? root.sheet.navi : @tr("{} · {}", root.sheet.navi, root.sheet.presets);
        color: root.usable ? Theme.muted : Theme.bad;
        font-family: Theme.body;
        font-size: 12px;
        vertical-alignment: center;
        overflow: elide;
    }

    // Its forms: their faces, each with its version's mark under it (as the overview's), as many as the row holds.
    for form[i] in root.sheet.forms: Rectangle {
        x: root.pad + i * 38px;
        y: 62px;
        width: 32px;
        height: 20px;
        visible: root.usable && self.x + 32px <= root.width - root.pad;
        Image {
            x: 0;
            y: 0;
            width: 32px;
            height: 16px;
            source: form.face;
            image-rendering: pixelated;
        }

        Rectangle {
            y: 18px;
            height: 2px;
            visible: form.version.text != "";
            background: form.version.tone;
        }
    }

    Text {
        x: root.pad;
        y: 88px;
        width: parent.width - 2 * root.pad;
        height: 18px;
        visible: root.usable;
        text: root.ruleset == "" ? @tr("{} · {}", root.hp, root.chips) : @tr("{} · {}", @tr("{} · {}", root.hp, root.chips), root.ruleset);
        color: Theme.text;
        font-family: Theme.body;
        font-size: 13px;
        vertical-alignment: center;
        overflow: elide;
    }

    Text {
        x: root.pad;
        y: 110px;
        width: parent.width - 2 * root.pad;
        height: 18px;
        visible: root.usable;
        text: "\{@tr("Abilities")} \{root.sheet.abilities.length == 0 ? @tr("None") : I18n.join(root.sheet.abilities)}";
        color: Theme.muted;
        font-family: Theme.body;
        font-size: 13px;
        vertical-alignment: center;
        overflow: elide;
    }
}

// One of the code's six boxes, for a pad: Up and Down go through its characters, Left and Right to the boxes
// beside it. (To the app's focus it is a list whose rows are all in one place, `count` of them: `Nav.index` is
// the character it is on.)
component CodeBox inherits Rectangle {
    in property <string> nav;
    in property <string> value;
    in property <int> count;
    property <[int]> token;
    property <length> ax: self.absolute-position.x;
    property <length> ay: self.absolute-position.y;
    function place() {
        Nav.page(root.nav, root.ax, root.ay, self.width, self.height, self.height, 0px);
        Nav.list(root.nav, root.count, 0px, self.height, 0px, self.width);
    }
    height: 64px;
    Rectangle {
        background: Theme.inset;
        border-width: 1px;
        border-color: Nav.id == root.nav ? Theme.cursor : Theme.line;
    }

    Path {
        y: 6px;
        width: 8px;
        height: 5px;
        fill: Theme.dim;
        commands: "M 0 5 L 8 5 L 4 0 Z";
    }

    Text {
        text: root.value;
        color: Theme.text;
        font-family: Theme.mono;
        font-size: 28px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    Path {
        y: parent.height - 11px;
        width: 8px;
        height: 5px;
        fill: Theme.dim;
        commands: "M 0 0 L 8 0 L 4 5 Z";
    }

    init => {
        root.token = Nav.register(root.nav, 0, NavKind.list);
        place();
    }
    changed ax => {
        place();
    }
    changed ay => {
        place();
    }
    changed count => {
        place();
    }
}

// The versions a new build starts from: Left and Right choose, a click takes one. A control's height (the user: "the
// version selector in new build is really tall for no reason").
component VersionChoice inherits Rectangle {
    in property <[VersionTag]> versions;
    in property <int> chosen;
    property <length> box: (self.width - (root.versions.length - 1) * 12px) / max(1, root.versions.length);
    height: Theme.control;
    for version[i] in root.versions: Rectangle {
        x: i * (root.box + 12px);
        width: root.box;
        background: Theme.inset;
        border-width: i == root.chosen ? 2px : 1px;
        border-color: i == root.chosen ? Theme.cursor : Theme.line;
        Text {
            text: version.text;
            color: version.tone;
            font-family: Theme.display;
            font-size: 14px;
            font-weight: Theme.display-bold;
            letter-spacing: 0.6px;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }

        TouchArea {
            mouse-cursor: self.enabled ? MouseCursor.pointer : MouseCursor.default;
            clicked => {
                Nav.point("name.version", 0);
                Nav.choose("name.version", 0, i);
            }
        }
    }

    Focusable {
        nav: "name.version";
        kind: NavKind.stepper;
        // (Its halves take the clicks.)
        z: -1;
    }
}

// ---- The lobby -------------------------------------------------------------------------------------------

// A player's card in the lobby: who they are, what they bring (this player's own card alone says it), and
// whether they are ready, in a box that is there either way. The mark stamps as its player turns ready. (While
// the host waits for the other player there is nothing to be ready for: no mark, `marked` off.)
component LobbyCard inherits Rectangle {
    in property <string> role;
    in property <string> name;
    in property <PlayBuild> build;
    in property <int> side;
    in property <bool> ready;
    in property <int> ready-seq;
    in property <bool> marked: true;
    property <length> pad: Theme.handheld ? 16px : 24px;
    // (A phone held sideways has the two side by side, 94 tall: its lines closer.)
    property <length> name-y: Theme.phone ? root.pad + 18px : Theme.sideways ? 22px : root.pad + 22px;
    property <length> build-y: Theme.phone ? root.pad + 52px : Theme.sideways ? 50px : root.pad + 66px;
    property <length> navi-y: Theme.phone ? root.pad + 78px : Theme.sideways ? 72px : root.pad + 95px;
    stamp := Pulse {
        seq: root.ready-seq;
        duration: Theme.settle;
    }

    PanelBack {
        side: root.side;
        accent: false;
    }

    Label {
        x: root.pad;
        y: Theme.sideways ? 8px : root.pad;
        width: parent.width - 2 * root.pad;
        height: 14px;
        text: root.role;
    }

    Value {
        x: root.pad;
        y: root.name-y;
        width: parent.width - 2 * root.pad;
        height: Theme.handheld ? 28px : 36px;
        text: root.name;
        font-size: Theme.handheld ? 22px : 28px;
        font-weight: 900;
    }

    HorizontalLayout {
        x: root.pad;
        y: root.build-y;
        width: parent.width - 2 * root.pad - (Theme.handheld ? mark.width + 12px : 0px);
        height: 22px;
        spacing: 8px;
        alignment: start;
        Value {
            text: root.build.name;
            font-size: Theme.handheld ? 14px : 16px;
        }
    }

    Value {
        x: root.pad;
        y: root.navi-y;
        width: parent.width - 2 * root.pad - (Theme.handheld ? mark.width + 12px : 0px);
        height: 16px;
        text: root.build.navi;
        color: Theme.muted;
        font-size: 12px;
        font-weight: 400;
    }

    mark := Rectangle {
        x: parent.width - root.pad - self.width;
        y: parent.height - root.pad - self.height;
        width: 144px;
        height: 32px;
        visible: root.marked;
        transform-scale: 1 + stamp.v * 0.16;
        Rectangle {
            border-width: 1px;
            border-color: root.ready ? Theme.good : Theme.line;
        }

        Flash {
            seq: root.ready-seq;
            tone: Theme.good;

            Rectangle { }  // (Copied in: docs/app.md §14.)
        }

        Label {
            x: 8px;
            width: parent.width - 16px;
            text: root.ready ? I18n.upper(@tr("Ready")) : I18n.upper(@tr("Not ready"));
            color: root.ready ? Theme.good : Theme.muted;
            font-size: 12px;
            font-weight: 700;
            horizontal-alignment: center;
        }
    }
}

// The other player's place while the host waits for them: what they need to come (the invite's code, large, in
// fixed-width type and grouped in threes, or this machine's address), COPY CODE (COPY ADDRESS), which flashes as
// it copies, and that they are waited for. (On a phone, in a card's 126: the words beside COPY, the line under
// them left out.)
component WaitCard inherits Rectangle {
    property <length> pad: Theme.handheld ? 16px : 24px;
    // (On a phone held sideways, in a card's 94: COPY at the top right, the words under the code.)
    property <bool> short: Theme.sideways;
    PanelBack {
        side: 2;
        accent: false;
    }

    Label {
        x: root.pad;
        y: Theme.phone ? 12px : root.short ? 8px : root.pad;
        width: parent.width - 2 * root.pad;
        height: 14px;
        text: PlayView.invite-direct ? I18n.upper(@tr("Your address")) : I18n.upper(@tr("Invite code"));
    }

    Mono {
        x: root.pad;
        y: Theme.phone ? 28px : root.short ? 22px : root.pad + 22px;
        width: parent.width - 2 * root.pad - (root.short ? copy.width + 12px : 0px);
        height: Theme.phone ? 48px : root.short ? 40px : 64px;
        text: PlayView.invite;
        font-size: PlayView.invite-direct ? (Theme.handheld ? 20px : 28px) : (Theme.phone ? 40px : root.short ? 32px : 56px);
        letter-spacing: PlayView.invite-direct ? 0px : 2.2px;
    }

    copy := Button {
        x: root.short ? parent.width - root.pad - self.width : root.pad;
        y: Theme.phone ? 80px : root.short ? 12px : root.pad + 98px;
        nav: "wait.copy";
        text: PlayView.invite-direct ? I18n.upper(@tr("Copy address")) : I18n.upper(@tr("Copy code"));
    }

    Flash {
        x: copy.x;
        y: copy.y;
        width: copy.width;
        height: copy.height;
        seq: PlayView.copied-seq;

        Rectangle { }  // (Copied in: docs/app.md §14.)
    }

    Rule {
        x: root.pad;
        y: root.pad + 162px;
        width: parent.width - 2 * root.pad;
        visible: !Theme.handheld;

        Rectangle { }  // (Copied in: docs/app.md §14.)
    }

    // That the other player is waited for: a slow pulse and its words (on a phone beside COPY; held sideways under
    // the code).
    property <length> waited-x: Theme.phone ? copy.x + copy.width + 16px : root.pad;
    property <length> waited-y: Theme.phone ? copy.y + (copy.height - 20px) / 2 : root.short ? 66px : root.pad + 182px;
    Rectangle {
        x: root.waited-x;
        y: root.waited-y + 5px;
        width: 10px;
        height: 10px;
        border-radius: 5px;
        background: Theme.cursor;
        opacity: Theme.motion ? 0.35 + 0.65 * abs(sin(mod(animation-tick(), 2.2s) / 2.2s * 360deg)) : 1;
    }

    Value {
        x: root.waited-x + 18px;
        y: root.waited-y;
        width: parent.width - self.x - root.pad;
        height: 20px;
        text: @tr("Waiting for opponent");
    }

    Note {
        x: root.pad;
        y: root.pad + 208px;
        width: parent.width - 2 * root.pad;
        height: 20px;
        visible: !Theme.handheld;
        text: PlayView.invite-direct ? @tr("Send this address to your opponent.") : @tr("The lobby opens when they join.");
    }
}

// The match's settings, the host's (the user: "only the host should be able to change rules"; both see them, the
// joiner's controls unavailable): one row, or on a phone a line each. First to, the Ruleset (with EDIT after it,
// the joiner's VIEW), Open setups and the Custom timer. What is each player's own, the input delay and the
// connection, is apart from them (`ConnectionFacts`).
component MatchFacts inherits Rectangle {
    // The one row: each setting's name over its control, a cell as wide as the wider of the two, so the cells fit
    // whatever the language. Where each cell starts, and the row's width. (On a phone held sideways closer, its
    // steppers' values and the select narrower: the window's width holds it.)
    property <length> gap: Theme.sideways ? 29px : 41px;
    property <length> x1: Theme.sideways ? 14px : 24px;
    property <length> value-width: Theme.sideways ? 52px : 84px;
    property <length> x2: self.x1 + max(first-to-label.width, first-to.width) + self.gap;
    property <length> x3: self.x2 + max(ruleset-label.width, ruleset.width + 8px + rules.width) + self.gap;
    property <length> x4: self.x3 + max(open-label.width, open.width) + self.gap;
    out property <length> natural-width: self.x4 + max(custom-time-label.width, custom-time.width) + root.x1;
    // On a phone, a line each: the name, and the control at the right.
    property <length> line: 44px;
    property <int> extra-lines: PlayView.ruleset-tiered ? (PlayView.ruleset-sub-kind > 0 ? 2 : 1) : 0;
    // A name's place and a control's, in the row.
    property <length> name-y: 10px;
    property <length> name-height: 18px;
    property <length> control-y: 32px;
    property <length> control-height: 36px;
    property <length> sub-y: Theme.sideways ? 80px : 82px;
    property <length> sub-h: Theme.sideways ? 28px : 30px;
    property <brush> name-color: Theme.phone ? Theme.text : Theme.muted;
    height: Theme.phone ? (4 + self.extra-lines) * self.line : (PlayView.ruleset-tiered ? (Theme.sideways ? 114px : 118px) : 78px);
    PanelBack {
        visible: !Theme.phone;
        accent: false;
    }

    first-to-label := Value {
        x: Theme.phone ? 0px : root.x1;
        y: Theme.phone ? 0px : root.name-y;
        height: Theme.phone ? root.line : root.name-height;
        text: @tr("First to");
        color: root.name-color;
    }

    // (The round wins that take the set: "2" under First to; in Japanese, 2本先取.)
    first-to := Stepper {
        x: Theme.phone ? parent.width - self.width : root.x1;
        y: Theme.phone ? (root.line - self.height) / 2 : root.control-y + (root.control-height - self.height) / 2;
        nav: "lobby.first-to";
        value: @tr("first to" => "{}", PlayView.first-to);
        value-width: root.value-width;
        numeric: true;
        enabled: PlayView.host;
    }

    Rectangle {
        x: root.x2 - (root.gap + 1px) / 2;
        y: 14px;
        width: 1px;
        height: 50px;
        visible: !Theme.phone;
        background: Theme.line;
    }

    // The Ruleset: the match's, by its name (docs/design/app-ui.md §2.59). The host's is a select of the game's
    // presets and their own, with EDIT, which opens its page; the joiner's can't be changed, and VIEW opens its
    // page to read.
    ruleset-label := Value {
        x: Theme.phone ? 0px : root.x2;
        y: Theme.phone ? root.line : root.name-y;
        height: Theme.phone ? root.line : root.name-height;
        text: @tr("Ruleset");
        color: root.name-color;
    }

    ruleset := Select {
        x: Theme.phone ? parent.width - rules.width - 8px - self.width : root.x2;
        y: Theme.phone ? root.line + (root.line - self.height) / 2 : root.control-y;
        width: Theme.sideways ? 150px : 176px;
        height: 36px;
        nav: "lobby.ruleset";
        value: PlayView.ruleset;
        enabled: PlayView.host && PlayView.random-rank == 0;
    }

    rules := Button {
        x: Theme.phone ? parent.width - self.width : root.x2 + ruleset.width + 8px;
        y: ruleset.y;
        width: self.natural-width;
        // (As tall as the select beside it.)
        height: ruleset.height;
        compact: true;
        nav: "lobby.rules";
        text: PlayView.host ? I18n.upper(@tr("Edit")) : I18n.upper(@tr("ruleset" => "View"));
    }

    // Tiered built-in ruleset sub-options: Level 2 (EXE5 5DS / Gate Solo-Party) -> Level 3 (Single / Mixed versions).
    Rectangle {
        x: root.x1;
        y: 76px;
        width: parent.width - 2 * root.x1;
        height: 1px;
        visible: !Theme.phone && PlayView.ruleset-tiered;
        background: Theme.line;
    }

    sub-label := Value {
        x: Theme.phone ? 0px : root.x2;
        y: Theme.phone ? 2 * root.line : root.sub-y;
        height: Theme.phone ? root.line : root.sub-h;
        visible: PlayView.ruleset-tiered && PlayView.ruleset-sub-kind > 0;
        text: PlayView.ruleset-sub-kind == 2 ? @tr("Gate mode") : @tr("5DS content");
        color: root.name-color;
    }

    sub-seg := Seg {
        x: Theme.phone ? parent.width - self.width : sub-label.x + sub-label.width + 8px;
        y: Theme.phone ? 2 * root.line + (root.line - self.height) / 2 : root.sub-y + (root.sub-h - self.height) / 2;
        visible: PlayView.ruleset-tiered && PlayView.ruleset-sub-kind > 0;
        nav: "lobby.ruleset-sub";
        first: PlayView.ruleset-sub-kind == 2 ? I18n.upper(@tr("ruleset" => "Solo")) : I18n.upper(@tr("Off"));
        second: PlayView.ruleset-sub-kind == 2 ? I18n.upper(@tr("ruleset" => "Party")) : I18n.upper(@tr("On"));
        chosen: PlayView.ruleset-sub ? 1 : 0;
        enabled: PlayView.host && PlayView.random-rank == 0;
    }

    mixed-label := Value {
        x: Theme.phone ? 0px : (PlayView.ruleset-sub-kind > 0 ? sub-seg.x + sub-seg.width + 20px : root.x2);
        y: Theme.phone ? (PlayView.ruleset-sub-kind > 0 ? 3 : 2) * root.line : root.sub-y;
        height: Theme.phone ? root.line : root.sub-h;
        visible: PlayView.ruleset-tiered;
        text: @tr("Versions");
        color: root.name-color;
    }

    mixed-seg := Seg {
        x: Theme.phone ? parent.width - self.width : mixed-label.x + mixed-label.width + 8px;
        y: Theme.phone ? (PlayView.ruleset-sub-kind > 0 ? 3 : 2) * root.line + (root.line - self.height) / 2 : root.sub-y + (root.sub-h - self.height) / 2;
        visible: PlayView.ruleset-tiered;
        nav: "lobby.ruleset-mixed";
        first: I18n.upper(@tr("ruleset" => "Single"));
        second: I18n.upper(@tr("ruleset" => "Mixed"));
        chosen: PlayView.ruleset-mixed ? 1 : 0;
        enabled: PlayView.host && PlayView.random-rank == 0;
    }

    Rectangle {
        x: root.x3 - (root.gap + 1px) / 2;
        y: 14px;
        width: 1px;
        height: 50px;
        visible: !Theme.phone;
        background: Theme.line;
    }

    // Open setups: each player may see the other's build in the match; off in a new lobby (the user: "closed
    // setups should be open setups instead and it should be off by default").
    open-label := Value {
        x: Theme.phone ? 0px : root.x3;
        y: Theme.phone ? (2 + root.extra-lines) * root.line : root.name-y;
        height: Theme.phone ? root.line : root.name-height;
        text: @tr("Open setups");
        color: root.name-color;
    }

    open := Seg {
        x: Theme.phone ? parent.width - self.width : root.x3;
        y: Theme.phone ? (2 + root.extra-lines) * root.line + (root.line - self.height) / 2 : root.control-y;
        nav: "lobby.open";
        first: I18n.upper(@tr("Off"));
        second: I18n.upper(@tr("On"));
        chosen: PlayView.open ? 1 : 0;
        enabled: PlayView.host;
    }

    Rectangle {
        x: root.x4 - (root.gap + 1px) / 2;
        y: 14px;
        width: 1px;
        height: 50px;
        visible: !Theme.phone;
        background: Theme.line;
    }

    // The custom screen's time limit (saito's own): its seconds, or ∞ for none, as the original's screen has none (the
    // user: "instead of Unlimited use the infinity sign for custom timer").
    custom-time-label := Value {
        x: Theme.phone ? 0px : root.x4;
        y: Theme.phone ? (3 + root.extra-lines) * root.line : root.name-y;
        height: Theme.phone ? root.line : root.name-height;
        text: @tr("Custom timer");
        color: root.name-color;
    }

    custom-time := Stepper {
        x: Theme.phone ? parent.width - self.width : root.x4;
        y: Theme.phone ? (3 + root.extra-lines) * root.line + (root.line - self.height) / 2 : root.control-y + (root.control-height - self.height) / 2;
        nav: "lobby.custom-time";
        value: PlayView.custom-time == 0 ? "∞" : @tr("custom timer" => "{}s", PlayView.custom-time);
        value-width: root.value-width;
        enabled: PlayView.host;
    }
}

// What is this player's own and not the match's, apart from the match's settings (the user: "the input delay and
// ping settings should probably be displayed separately from the lobby settings, since those are client-local
// things"): the input delay (the Settings' value, kept as it is changed; the other player never sees it) and the
// connection's bars and round trip (nothing while nobody has come). As `MatchFacts`: a row, or a line each.
component ConnectionFacts inherits Rectangle {
    property <length> gap: Theme.sideways ? 29px : 41px;
    property <length> x1: Theme.sideways ? 14px : 24px;
    property <length> x2: self.x1 + max(delay-label.width, delay.width) + self.gap;
    out property <length> natural-width: self.x2 + max(ping-label.width, bars.width + 10px + ping.width) + root.x1;
    property <length> line: 44px;
    property <length> name-y: 10px;
    property <length> name-height: 18px;
    property <length> control-y: 32px;
    property <length> control-height: 36px;
    property <brush> name-color: Theme.phone ? Theme.text : Theme.muted;
    height: Theme.phone ? 2 * self.line : 78px;
    PanelBack {
        visible: !Theme.phone;
        accent: false;
    }

    delay-label := Value {
        x: Theme.phone ? 0px : root.x1;
        y: Theme.phone ? 0px : root.name-y;
        height: Theme.phone ? root.line : root.name-height;
        text: @tr("Input delay");
        color: root.name-color;
    }

    delay := Stepper {
        x: Theme.phone ? parent.width - self.width : root.x1;
        y: Theme.phone ? (root.line - self.height) / 2 : root.control-y + (root.control-height - self.height) / 2;
        nav: "lobby.delay";
        value: PlayView.input-delay;
        value-width: 48px;
        numeric: true;
    }

    Rectangle {
        x: root.x2 - (root.gap + 1px) / 2;
        y: 14px;
        width: 1px;
        height: 50px;
        visible: !Theme.phone;
        background: Theme.line;
    }

    // The connection: its bars and the round trip, where a setting has its control.
    ping-label := Value {
        x: Theme.phone ? 0px : root.x2;
        y: Theme.phone ? root.line : root.name-y;
        height: Theme.phone ? root.line : root.name-height;
        text: @tr("Ping");
        color: root.name-color;
    }

    bars := Bars {
        x: Theme.phone ? parent.width - ping.width - 10px - self.width : root.x2;
        y: (Theme.phone ? root.line + (root.line - self.height) / 2 : root.control-y + (root.control-height - self.height) / 2);
        level: PlayView.bars;
    }

    ping := Mono {
        x: Theme.phone ? parent.width - self.width : root.x2 + bars.width + 10px;
        y: Theme.phone ? root.line : root.control-y;
        width: 60px;
        height: Theme.phone ? root.line : root.control-height;
        horizontal-alignment: Theme.phone ? right : left;
        text: PlayView.ping < 0 ? "" : @tr("{} ms", PlayView.ping);
    }
}

// The lobby content shared by desktop/landscape (full `Page` body) and portrait phone (inside a `ScrollPage` so
// lower controls stay above Android's virtual navigation bar and remain reachable on compact screens, S-061).
component LobbyBody inherits Rectangle {
    in property <length> viewport-height;
    property <length> vs-width: Theme.sideways ? 54px : 80px;
    property <length> place-width: Theme.phone ? self.width : Theme.sideways ? (self.width - self.vs-width) / 2 : 480px;
    property <length> place-height: Theme.phone ? 126px : Theme.sideways ? 94px : 320px;
    property <length> lobby-top: Theme.handheld ? 0px : (self.viewport-height - (PlayView.ruleset-tiered ? 588px : 548px)) / 2;
    property <length> lobby-left: (self.width - 2 * self.place-width - self.vs-width) / 2;
    property <length> their-x: Theme.phone ? 0px : self.lobby-left + self.place-width + self.vs-width;
    property <length> their-y: Theme.phone ? self.place-height + 8px : self.lobby-top;
    property <length> facts-top: Theme.phone ? 2 * self.place-height + 20px : Theme.sideways ? self.place-height + 8px : self.lobby-top + self.place-height + 24px;
    property <length> buttons-top: Theme.phone ? connection.y + connection.height + 20px : Theme.sideways ? connection.y + connection.height - 52px : match-facts.y + match-facts.height + 24px;
    out property <length> scroll-height: Theme.phone ? pills.y + pills.height + 42px : connection.y + connection.height + 16px;

    // The other player's card slides in as they join.
    joined := Tween {
        held: !PlayView.their-present;
    }

    Arrive {
        order: 0;
        if !PlayView.waiting || Theme.handheld: LobbyCard {
            x: Theme.phone ? 0px : root.lobby-left;
            y: root.lobby-top;
            width: root.place-width;
            height: root.place-height;
            role: PlayView.you;
            name: Shell.player;
            build: PlayView.card;
            side: 1;
            ready: PlayView.ready;
            ready-seq: PlayView.ready-seq;
            marked: !PlayView.waiting;
        }

        // The wait's practice battle, at twice the battle's size, in this player's place.
        if PlayView.waiting && !Theme.handheld: Rectangle {
            x: root.lobby-left;
            y: root.lobby-top;
            width: root.place-width;
            height: root.place-height;
            Picture {
                x: 0;
                y: 0;
                width: root.place-width;
                height: root.place-height;
                ground: Theme.inset;
            }

            Rectangle {
                x: 12px;
                y: parent.height - 34px;
                width: practice.preferred-width + 16px;
                height: 22px;
                background: Theme.shade;
                practice := Text {
                    text: I18n.upper(@tr("Practice"));
                    color: Theme.text;
                    font-family: Theme.display;
                    font-size: 11px;
                    font-weight: Theme.display-bold;
                    letter-spacing: Theme.label-tracking;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        Text {
            x: root.lobby-left + root.place-width;
            y: root.lobby-top;
            width: root.vs-width;
            height: root.place-height;
            visible: !Theme.phone;
            text: @tr("VS");
            color: Theme.dim;
            font-family: Theme.display;
            font-size: 28px;
            font-weight: Theme.display-bold;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        if PlayView.waiting: WaitCard {
            x: root.their-x;
            y: root.their-y;
            width: root.place-width;
            height: root.place-height;
        }
    }

    Rectangle {
        x: (1 - joined.t) * 56px;
        opacity: joined.t;
        visible: PlayView.their-present;
        LobbyCard {
            x: root.their-x;
            y: root.their-y;
            width: root.place-width;
            height: root.place-height;
            role: PlayView.opponent;
            name: PlayView.their-name;
            side: 2;
            ready: PlayView.their-ready;
            ready-seq: PlayView.their-ready-seq;
        }
    }

    // The match's settings, and apart from them this player's own: each group named over it on a desktop;
    // on a phone a line each, the player's own under a name of their own.
    Arrive {
        order: 1;
        Label {
            x: match-facts.x;
            y: root.facts-top;
            width: match-facts.width;
            height: 14px;
            visible: !Theme.phone;
            text: I18n.upper(@tr("Match settings"));
        }

        match-facts := MatchFacts {
            x: Theme.phone ? 0px : Theme.sideways ? 0px : (root.width - self.natural-width - 24px - connection.natural-width) / 2;
            y: Theme.phone ? root.facts-top : root.facts-top + 22px;
            width: Theme.phone ? root.width : Theme.sideways ? max(self.natural-width, root.width) : self.natural-width;

            Rectangle { }  // (Copied in: docs/app.md §14.)
        }

        Label {
            x: connection.x;
            y: Theme.phone ? match-facts.y + match-facts.height + 12px : Theme.sideways ? pills.y + pills.height + 10px : root.facts-top;
            width: Theme.phone ? root.width : connection.width;
            height: 14px;
            text: I18n.upper(@tr("Your connection"));
        }

        connection := ConnectionFacts {
            x: Theme.phone ? 0px : Theme.sideways ? 0px : match-facts.x + match-facts.width + 24px;
            y: Theme.phone ? match-facts.y + match-facts.height + 32px : Theme.sideways ? pills.y + pills.height + 28px : match-facts.y;
            width: Theme.phone ? root.width : self.natural-width;

            Rectangle { }  // (Copied in: docs/app.md §14.)
        }
    }

    Arrive {
        order: 2;
        // With the other player: READY, CHANGE BUILD and LEAVE. (On a phone READY the column's width, the
        // other two half of it each under it; held sideways the three beside the connection, READY taking what
        // the other two leave, each 52 tall.)
        ready := Button {
            x: Theme.phone ? 0px : Theme.sideways ? (connection.width + 14px) : (root.width - self.width - change.width - leave.width - 24px) / 2;
            y: root.buttons-top;
            width: Theme.phone ? root.width : Theme.sideways ? max(80px, root.width - (connection.width + 14px) - change.width - leave.width - 16px) : 184px;
            visible: !PlayView.waiting;
            enabled: !PlayView.waiting;
            nav: "lobby.ready";
            text: PlayView.ready ? I18n.upper(@tr("Not ready")) : I18n.upper(@tr("Ready"));
            kind: ButtonKind.main;
            big: Theme.handheld;
        }

        change := Button {
            x: Theme.phone ? 0px : ready.x + ready.width + (Theme.sideways ? 8px : 12px);
            y: Theme.phone ? root.buttons-top + 60px : root.buttons-top;
            width: Theme.phone ? (root.width - 8px) / 2 : self.natural-width;
            visible: !PlayView.waiting;
            enabled: !PlayView.waiting;
            nav: "lobby.change";
            text: I18n.upper(@tr("Change build"));
            big: Theme.sideways;
        }

        leave := Button {
            x: Theme.phone ? change.width + 8px : change.x + change.width + (Theme.sideways ? 8px : 12px);
            y: change.y;
            width: Theme.phone ? (root.width - 8px) / 2 : self.natural-width;
            visible: !PlayView.waiting;
            enabled: !PlayView.waiting;
            nav: "lobby.leave";
            text: I18n.upper(@tr("Leave"));
            kind: ButtonKind.ghost;
            big: Theme.sideways;
        }

        // While the host waits: the way out, CANCEL INVITE (STOP HOSTING), as the practice menu has it in
        // EXIT's place; on a phone PRACTICE before it, which starts the practice battle filling the window (held
        // sideways the two in READY's row).
        train := Button {
            x: Theme.sideways ? (connection.width + 14px) : 0px;
            y: root.buttons-top;
            width: Theme.sideways ? max(80px, root.width - (connection.width + 14px) - cancel.width - 8px) : root.width;
            visible: PlayView.waiting && Theme.handheld;
            enabled: PlayView.waiting && Theme.handheld;
            nav: "wait.train";
            text: I18n.upper(@tr("Practice"));
            kind: ButtonKind.main;
            big: true;
        }

        cancel := Button {
            x: Theme.phone ? 0px : Theme.sideways ? root.width - self.width : (root.width - self.width) / 2;
            y: Theme.phone ? root.buttons-top + 60px : root.buttons-top;
            width: Theme.phone ? root.width : self.natural-width;
            visible: PlayView.waiting;
            enabled: PlayView.waiting;
            nav: "wait.cancel";
            text: PlayView.wait-exit(PlayView.invite-direct);
            kind: ButtonKind.ghost;
            big: Theme.sideways;
        }

        // Client-local Stage & BGM mode + EXE6 Random Battle / EXE4-5 Dark Soul AI / EXE5-6 CS Prob Fix + host spectator controls.
        pills := Rectangle {
            property <bool> show-spec: PlayView.host && !PlayView.invite-direct;
            property <bool> show-random: PlayView.random-supported;
            property <bool> show-abd: PlayView.abd-supported;
            property <bool> show-cs-prob: PlayView.cs-prob-supported;
            property <bool> show-extra-rule: PlayView.all-guard-supported || PlayView.dark-cut-in-supported;
            property <bool> show-sun: PlayView.ds-sun-supported;
            property <bool> show-shout-mode: PlayView.ds-shout-supported;
            property <length> btn-h: Theme.sideways ? 28px : 34px;
            property <length> row-step: self.btn-h + 6px;
            property <length> gap: Theme.sideways ? 6px : 10px;
            property <length> max-w: max(1px, self.width);

            // Greedy flow-wrap across rows so buttons never overflow horizontally on any screen width.
            // 0: stage-btn (always visible)
            property <int> r0: 0;
            property <length> x0: 0px;
            property <length> end0: stage-btn.width;

            // 1: random-btn
            property <bool> fit1: self.end0 + self.gap + random-btn.width <= self.max-w;
            property <int> r1: self.show-random ? (self.fit1 ? self.r0 : self.r0 + 1) : self.r0;
            property <length> x1: self.fit1 ? self.end0 + self.gap : 0px;
            property <length> end1: self.show-random ? self.x1 + random-btn.width : self.end0;

            // 2: abd-btn + abd-guide-btn (kept paired)
            property <length> abd-pair-w: abd-btn.width + 4px + abd-guide-btn.width;
            property <bool> fit2: self.end1 + self.gap + self.abd-pair-w <= self.max-w;
            property <int> r2: self.show-abd ? (self.fit2 ? self.r1 : self.r1 + 1) : self.r1;
            property <length> x2: self.fit2 ? self.end1 + self.gap : 0px;
            property <length> end2: self.show-abd ? self.x2 + self.abd-pair-w : self.end1;

            // 3: abd-cap-btn (4px after abd-guide-btn when on the same row)
            property <bool> fit3: self.end2 + 4px + abd-cap-btn.width <= self.max-w;
            property <int> r3: self.show-abd ? (self.fit3 ? self.r2 : self.r2 + 1) : self.r2;
            property <length> x3: self.fit3 ? self.end2 + 4px : 0px;
            property <length> end3: self.show-abd ? self.x3 + abd-cap-btn.width : self.end2;

            // 4: cs-prob-btn
            property <bool> fit4: self.end3 + self.gap + cs-prob-btn.width <= self.max-w;
            property <int> r4: self.show-cs-prob ? (self.fit4 ? self.r3 : self.r3 + 1) : self.r3;
            property <length> x4: self.fit4 ? self.end3 + self.gap : 0px;
            property <length> end4: self.show-cs-prob ? self.x4 + cs-prob-btn.width : self.end3;

            // 5: extra-rule-btn
            property <bool> fit5: self.end4 + self.gap + extra-rule-btn.width <= self.max-w;
            property <int> r5: self.show-extra-rule ? (self.fit5 ? self.r4 : self.r4 + 1) : self.r4;
            property <length> x5: self.fit5 ? self.end4 + self.gap : 0px;
            property <length> end5: self.show-extra-rule ? self.x5 + extra-rule-btn.width : self.end4;

            // 6: sun-btn (EXE5 Outdoor / Indoor sunlight)
            property <bool> fit6: self.end5 + self.gap + sun-btn.width <= self.max-w;
            property <int> r6: self.show-sun ? (self.fit6 ? self.r5 : self.r5 + 1) : self.r5;
            property <length> x6: self.fit6 ? self.end5 + self.gap : 0px;
            property <length> end6: self.show-sun ? self.x6 + sun-btn.width : self.end5;

            // 7: shout-mode-btn (EXE5DS 3-Tier / Always Max)
            property <bool> fit7: self.end6 + self.gap + shout-mode-btn.width <= self.max-w;
            property <int> r7: self.show-shout-mode ? (self.fit7 ? self.r6 : self.r6 + 1) : self.r6;
            property <length> x7: self.fit7 ? self.end6 + self.gap : 0px;
            property <length> end7: self.show-shout-mode ? self.x7 + shout-mode-btn.width : self.end6;

            // 8: spec-vis (kept together with spec-delay on a fresh row when the pair fits in max-w)
            property <length> spec-pair-w: spec-vis.width + self.gap + spec-delay.width;
            property <bool> fit8: self.end7 + self.gap + (self.spec-pair-w <= self.max-w ? self.spec-pair-w : spec-vis.width) <= self.max-w;
            property <int> r8: self.show-spec ? (self.fit8 ? self.r7 : self.r7 + 1) : self.r7;
            property <length> x8: self.fit8 ? self.end7 + self.gap : 0px;
            property <length> end8: self.show-spec ? self.x8 + spec-vis.width : self.end7;

            // 9: spec-delay
            property <bool> fit9: self.end8 + self.gap + spec-delay.width <= self.max-w;
            property <int> r9: self.show-spec ? (self.fit9 ? self.r8 : self.r8 + 1) : self.r8;
            property <length> x9: self.fit9 ? self.end8 + self.gap : 0px;
            property <length> end9: self.show-spec ? self.x9 + spec-delay.width : self.end8;

            pure function row-x(r: int) -> length {
                let rw = self.r9 == r ? self.end9
                    : self.r8 == r ? self.end8
                    : self.r7 == r ? self.end7
                    : self.r6 == r ? self.end6
                    : self.r5 == r ? self.end5
                    : self.r4 == r ? self.end4
                    : self.r3 == r ? self.end3
                    : self.r2 == r ? self.end2
                    : self.r1 == r ? self.end1
                    : self.end0;
                return max(0px, (self.width - rw) / 2);
            }

            x: 0px;
            y: Theme.sideways ? match-facts.y + match-facts.height + 8px : Theme.phone ? match-facts.y + match-facts.height + connection.height + 160px : match-facts.y + match-facts.height + 116px;
            width: root.width;
            height: self.r9 * self.row-step + self.btn-h;

            stage-btn := Button {
                x: parent.row-x(parent.r0) + parent.x0;
                y: parent.r0 * parent.row-step;
                height: parent.btn-h;
                compact: true;
                nav: "lobby.stage";
                kind: ButtonKind.ghost;
                text: @tr("Stage & BGM: {}", PlayView.stage-mode == 1 ? @tr("stage mode" => "Full random") : PlayView.stage-mode == 2 ? @tr("stage mode" => "Escalating") : PlayView.stage-mode == 3 ? @tr("stage mode" => "Custom") : @tr("stage mode" => "Default"));
            }

            random-btn := Button {
                x: parent.row-x(parent.r1) + parent.x1;
                y: parent.r1 * parent.row-step;
                height: parent.btn-h;
                compact: true;
                visible: parent.show-random;
                enabled: parent.show-random && PlayView.host;
                nav: parent.show-random && PlayView.host ? "lobby.random-battle" : "";
                kind: PlayView.random-rank > 0 ? ButtonKind.normal : ButtonKind.ghost;
                text: @tr("Random Battle: {}", PlayView.random-rank == 1 ? @tr("Rank 1") : PlayView.random-rank == 2 ? @tr("Rank 2") : PlayView.random-rank == 3 ? @tr("Rank 3") : @tr("Off"));
            }

            abd-btn := Button {
                x: parent.row-x(parent.r2) + parent.x2;
                y: parent.r2 * parent.row-step;
                height: parent.btn-h;
                compact: true;
                visible: parent.show-abd;
                enabled: parent.show-abd && PlayView.host;
                nav: parent.show-abd && PlayView.host ? "lobby.abd-mode" : "";
                kind: PlayView.abd-mode > 0 ? ButtonKind.normal : ButtonKind.ghost;
                text: @tr("Dark Soul AI: {}", PlayView.abd-mode == 1 ? @tr("Legacy Collection") : PlayView.abd-mode == 2 ? @tr("DS") : @tr("Original"));
            }

            abd-guide-btn := Button {
                x: abd-btn.x + abd-btn.width + 4px;
                y: abd-btn.y;
                width: Theme.sideways ? 28px : 32px;
                height: abd-btn.height;
                compact: true;
                tight: true;
                visible: parent.show-abd;
                enabled: parent.show-abd;
                nav: parent.show-abd ? "lobby.abd-guide" : "";
                kind: ButtonKind.ghost;
                text: "?";
            }

            abd-cap-btn := Button {
                x: parent.row-x(parent.r3) + parent.x3;
                y: parent.r3 * parent.row-step;
                height: parent.btn-h;
                compact: true;
                visible: parent.show-abd;
                enabled: parent.show-abd && PlayView.host;
                nav: parent.show-abd && PlayView.host ? "lobby.abd-cap" : "";
                kind: PlayView.abd-chip-cap > 0 ? ButtonKind.normal : ButtonKind.ghost;
                text: PlayView.abd-chip-cap > 0 ? @tr("ABD Cap: {}", PlayView.abd-chip-cap) : @tr("ABD Cap: Off");
            }

            cs-prob-btn := Button {
                x: parent.row-x(parent.r4) + parent.x4;
                y: parent.r4 * parent.row-step;
                height: parent.btn-h;
                compact: true;
                visible: parent.show-cs-prob;
                enabled: parent.show-cs-prob;
                nav: parent.show-cs-prob ? "lobby.cs-prob" : "";
                kind: PlayView.cs-prob-count > 0 ? ButtonKind.normal : ButtonKind.ghost;
                text: PlayView.cs-prob-count == 0
                    ? @tr("CS Prob Fix: Original")
                    : PlayView.cs-prob-recommended
                        ? @tr("CS Prob Fix: Battle Default")
                        : PlayView.cs-prob-count >= PlayView.cs-prob-total
                            ? @tr("CS Prob Fix: All Fixed")
                            : @tr("CS Prob Fix: Custom ({}/{})", PlayView.cs-prob-count, PlayView.cs-prob-total);
            }

            extra-rule-btn := Button {
                x: parent.row-x(parent.r5) + parent.x5;
                y: parent.r5 * parent.row-step;
                height: parent.btn-h;
                compact: true;
                visible: parent.show-extra-rule;
                enabled: parent.show-extra-rule && PlayView.host;
                nav: parent.show-extra-rule && PlayView.host ? "lobby.extra-rule" : "";
                kind: (PlayView.all-guard-supported && PlayView.all-guard-disabled) || (PlayView.dark-cut-in-supported && PlayView.dark-cut-in-fix) ? ButtonKind.normal : ButtonKind.ghost;
                text: PlayView.all-guard-supported
                    ? @tr("All Guard: {}", PlayView.all-guard-disabled ? @tr("Off (LC)") : @tr("On (Original)"))
                    : @tr("Dark Cut-In: {}", PlayView.dark-cut-in-fix ? @tr("Legacy Collection") : @tr("Original"));
            }

            sun-btn := Button {
                x: parent.row-x(parent.r6) + parent.x6;
                y: parent.r6 * parent.row-step;
                height: parent.btn-h;
                compact: true;
                visible: parent.show-sun;
                enabled: parent.show-sun && PlayView.host;
                nav: parent.show-sun && PlayView.host ? "lobby.sun" : "";
                kind: !PlayView.sun-enabled ? ButtonKind.normal : ButtonKind.ghost;
                text: @tr("Sunlight: {}", PlayView.sun-enabled ? @tr("Outdoor") : @tr("Indoor"));
            }

            shout-mode-btn := Button {
                x: parent.row-x(parent.r7) + parent.x7;
                y: parent.r7 * parent.row-step;
                height: parent.btn-h;
                compact: true;
                visible: parent.show-shout-mode;
                enabled: parent.show-shout-mode && PlayView.host;
                nav: parent.show-shout-mode && PlayView.host ? "lobby.shout-mode" : "";
                kind: PlayView.ds-shout-max-only ? ButtonKind.normal : ButtonKind.ghost;
                text: @tr("Shout: {}", PlayView.ds-shout-max-only ? @tr("Always Max") : @tr("3-Tier"));
            }

            spec-vis := Button {
                x: parent.row-x(parent.r8) + parent.x8;
                y: parent.r8 * parent.row-step;
                height: parent.btn-h;
                compact: true;
                visible: parent.show-spec;
                enabled: parent.show-spec;
                nav: "lobby.spectate";
                kind: ButtonKind.ghost;
                text: PlayView.spectate-visibility == 0 ? @tr("Room: Private") : PlayView.spectate-visibility == 2 ? @tr("Room: Public") : @tr("Room: Code");
            }

            spec-delay := Button {
                x: parent.row-x(parent.r9) + parent.x9;
                y: parent.r9 * parent.row-step;
                height: parent.btn-h;
                compact: true;
                visible: parent.show-spec;
                enabled: parent.show-spec && PlayView.spectate-visibility != 0;
                nav: "lobby.spectate-delay";
                kind: ButtonKind.ghost;
                text: PlayView.spectate-delay == 0 ? @tr("Delay: Off") : @tr("Delay: {}s", PlayView.spectate-delay);
            }
        }

        // The reserved line: who is waited for, that the link is being made again, why the match before
        // ended, or what keeps this player's build from being played.
        Message {
            x: Theme.sideways ? (connection.width + 14px) : 0px;
            y: Theme.sideways ? connection.y + 4px : Theme.phone ? pills.y + pills.height + 10px : root.buttons-top + 56px;
            width: Theme.sideways ? root.width - (connection.width + 14px) : root.width;
            text: PlayView.note == LobbyNote.reconnecting ? @tr("Reconnecting {} s", PlayView.note-seconds) : PlayView.note == LobbyNote.unusable ? PlayView.note-problem : PlayView.note-error != "" ? PlayView.note-error : PlayView.note == LobbyNote.you ? @tr("Waiting for you to ready up.") : PlayView.note == LobbyNote.them ? @tr("Waiting for your opponent to ready up.") : "";
            tone: PlayView.note-error != "" || PlayView.note == LobbyNote.reconnecting || PlayView.note == LobbyNote.unusable ? Theme.bad : Theme.muted;
            mark: PlayView.note == LobbyNote.unusable;
            horizontal-alignment: center;
        }
    }
}

// ---- The screen ------------------------------------------------------------------------------------------

export component PlayScreen inherits Page {
    property <[Hint]> hints-builds: [
        { key: "↑↓←→", pad: PadButton.move, text: @tr("Move") },
        { key: Shell.key-a, pad: Shell.pad-a, text: @tr("Choose") },
        { key: "Del", pad: Shell.pad-delete, text: @tr("Delete") },
        { key: Shell.key-b, pad: Shell.pad-b, text: @tr("Back") },
        { key: Shell.key-l, key2: Shell.key-r, pad: PadButton.shoulders, text: @tr("Change game") },
    ];
    property <[Hint]> hints-waiting: [
        { key: "Esc", pad: PadButton.start, text: @tr("Practice menu") },
        { key: "↑↓←→", pad: PadButton.move, text: @tr("Fight") },
    ];
    property <[Hint]> hints-lobby: [
        { key: "↑↓←→", pad: PadButton.move, text: @tr("Move") },
        { key: Shell.key-a, pad: Shell.pad-a, text: @tr("Choose") },
        { key: "Tab", pad: PadButton.shoulders, text: @tr("Next") },
        { key: Shell.key-b, pad: Shell.pad-b, text: @tr("Leave") },
    ];
    // The builds' part, in three zones read in order (docs/design/app-ui.md §6, "Play"): the builds (+ NEW BUILD
    // over the list, the left column); the chosen build (its overview, the right column, with PRACTICE, EDIT and ⋯
    // in its header); and the ways to play it online, one row of controls under the overview (HOST, then JOIN's
    // field and JOIN, and DIRECT CONNECT at its right edge; the reserved line under them). On a phone one column
    // in the same order. On a phone held sideways (docs/design/app-ui.md §2.103) the list in a panel at the left; at
    // the right the chosen build's card (`BuildCard`, the overview having no room), HOST 52 tall under it, the code
    // and JOIN under that, and DIRECT CONNECT at the foot's right with the reserved line beside it.
    property <length> list-width: Theme.sideways ? 290px : 400px;
    property <length> side-x: root.list-width + (Theme.sideways ? 12px : 24px);
    property <length> side-width: self.body-width - root.side-x;
    // (Sideways: the card's height, and where HOST's row, the code's and the foot's are.)
    property <length> card-height: 140px;
    property <length> host-y: Theme.sideways ? root.card-height + 12px : root.row-y;
    property <length> code-y: root.host-y + 52px + 12px;
    property <length> foot-y: root.code-y + 40px + 8px;
    // (The reserved line: sideways beside DIRECT CONNECT, in the middle of the foot's 40.)
    property <length> line-y: Theme.sideways ? root.foot-y + 11px : root.message-y;
    // The row (the controls' height) and the reserved line under it at the body's foot; the list and the
    // overview grow down to 16 over the row (564 at the reference window: the wide sheet's 540 at least).
    property <length> message-y: Theme.phone ? 356px : self.body-height - 18px;
    property <length> row-y: Theme.phone ? 188px : root.message-y - 6px - 40px;
    property <length> sheet-height: max(540px, root.row-y - 16px);
    property <length> more-width: 40px;
    property <bool> none: PlayView.builds.length == 0;
    property <bool> usable: PlayView.chosen >= 0 && !root.none && PlayView.readable;
    title: PlayView.part == PlayPart.spectate ? I18n.upper(@tr("Spectate")) : PlayView.part == PlayPart.lobby ? I18n.upper(@tr("Lobby")) : I18n.upper(@tr("Play"));
    back: PlayView.part == PlayPart.builds ? I18n.upper(@tr("Menu")) : I18n.upper(@tr("Play"));
    hints: PlayView.part == PlayPart.spectate ? [] : PlayView.part == PlayPart.lobby ? (PlayView.waiting ? root.hints-waiting : root.hints-lobby) : root.hints-builds;
    // (The builds of the game while they show; active spectator count in lobby/spectate.)
    status: PlayView.part == PlayPart.builds ? @tr("{n} build" | "{n} builds" % PlayView.builds.length) : PlayView.part == PlayPart.spectate ? (PlayView.watch-spectators > 0 ? @tr("{} watching", PlayView.watch-spectators) : "") : (PlayView.spectators > 0 ? @tr("{} watching", PlayView.spectators) : "");

    // ---- The builds, what is done with them, and the row that makes a link ----
    // (One conditional a part, and what differs on a phone by its place and by `visible`: each conditional is a
    // component of its own in what Slint generates. A control that isn't shown is unavailable, so the focus
    // passes it by.)
    if PlayView.part == PlayPart.builds: Rectangle {
        x: 0;
        y: 0;
        width: root.body-width;
        height: root.body-height;
        // The builds: + NEW BUILD (the main action while there is none), and the builds as a list (a right click
        // on a row opens its menu); on a phone the chosen one in a box, which opens them as a sheet.
        Arrive {
            order: 0;
            PanelBack {
                x: 0;
                y: 0;
                width: root.list-width;
                height: root.body-height;
                visible: Theme.sideways;
                accent: false;
            }

            Button {
                x: Theme.sideways ? 12px : 0px;
                y: Theme.sideways ? 12px : 0px;
                width: Theme.phone ? root.body-width : self.natural-width;
                nav: "new";
                text: I18n.upper(@tr("+ New build"));
                kind: root.none ? ButtonKind.main : ButtonKind.normal;
            }

            list := ListView {
                x: Theme.sideways ? 4px : 0px;
                y: Theme.sideways ? 64px : 52px;
                width: root.list-width - (Theme.sideways ? 8px : 0px);
                height: Theme.sideways ? root.body-height - self.y - 4px : root.sheet-height - self.y;
                visible: !Theme.phone;
                nav: "builds";
                count: Theme.phone ? 0 : PlayView.builds.length;
                row-height: 52px;
                chosen: PlayView.chosen;
                for slot in list.shown: BuildRow {
                    property <int> at: list.first + slot;
                    x: 0;
                    y: self.at * list.pitch;
                    width: list.row-width;
                    height: list.row-height;
                    build: PlayView.builds[self.at];
                    nav: list.nav;
                    nav-index: self.at;
                    menu: true;
                }
            }

            BuildBox {
                x: 0;
                y: 52px;
                width: root.body-width;
                visible: Theme.phone && !root.none;
                enabled: Theme.phone && !root.none;
                nav: "build";
                build: PlayView.build;

                Rectangle { }  // (Copied in: docs/app.md §14.)
            }
        }

        // The chosen build: its overview (the wide sheet) with EDIT, PRACTICE, DUPLICATE and DELETE in its header's
        // right; on a phone, no overview, and the four in a row under the box. A build whose file doesn't read has an
        // empty frame, with only DELETE available. With no build none are shown.
        Arrive {
            order: 1;
            property <length> phone-action-w: (root.body-width - 18px) / 4;
            property <length> action-gap: Theme.phone ? 6px : 8px;
            PanelBack {
                x: root.side-x;
                y: 0;
                width: root.side-width;
                height: root.sheet-height;
                visible: !Theme.handheld && !root.none && !root.usable;
            }

            BuildOverview {
                x: root.side-x;
                y: 0;
                // (On a phone it isn't shown, and is given the wide sheet's least width: its texts fit there.)
                width: Theme.handheld ? 620px : root.side-width;
                height: Theme.handheld ? self.sheet-height : root.sheet-height;
                visible: !Theme.handheld && root.usable && PlayView.sheet.name != "";
                build: PlayView.sheet;
                tools: edit.width + 8px + practice-btn.width + 8px + duplicate-btn.width + 8px + delete-btn.width;
                scroll <=> PlayView.sheet-y;
                init => {
                    PlayView.sheet-span = self.span;
                    PlayView.sheet-view = self.view;
                }
                changed span => {
                    PlayView.sheet-span = self.span;
                }
                changed view => {
                    PlayView.sheet-view = self.view;
                }
            }

            BuildCard {
                x: root.side-x;
                y: 0;
                width: root.side-width;
                height: root.card-height;
                visible: Theme.sideways && !root.none;
                build: PlayView.build;
                sheet: PlayView.sheet;
                usable: root.usable && PlayView.sheet.name != "";
                tools: root.body-width - edit.x;

                Rectangle { }  // (Copied in: docs/app.md §14.)
            }

            edit := Button {
                x: Theme.phone ? 0px : practice-btn.x - parent.action-gap - self.width;
                y: Theme.phone ? 136px : Theme.sideways ? 12px : 24px;
                width: Theme.phone ? parent.phone-action-w : self.natural-width;
                compact: true;
                tight: Theme.phone;
                visible: !root.none;
                nav: "edit";
                text: I18n.upper(@tr("Edit"));
                enabled: root.usable;
            }

            practice-btn := Button {
                x: Theme.phone ? parent.phone-action-w + parent.action-gap : duplicate-btn.x - parent.action-gap - self.width;
                y: edit.y;
                width: Theme.phone ? parent.phone-action-w : self.natural-width;
                compact: true;
                tight: Theme.phone;
                visible: !root.none;
                nav: "practice";
                text: PlayView.practice-word;
                enabled: root.usable;
            }

            duplicate-btn := Button {
                x: Theme.phone ? 2 * (parent.phone-action-w + parent.action-gap) : delete-btn.x - parent.action-gap - self.width;
                y: edit.y;
                width: Theme.phone ? parent.phone-action-w : self.natural-width;
                compact: true;
                tight: Theme.phone;
                visible: !root.none;
                nav: "duplicate";
                text: PlayView.duplicate-word;
                enabled: root.usable;
            }

            delete-btn := Button {
                x: Theme.phone ? 3 * (parent.phone-action-w + parent.action-gap) : root.body-width - (Theme.sideways ? 12px : 16px) - self.width;
                y: edit.y;
                width: Theme.phone ? parent.phone-action-w : self.natural-width;
                compact: true;
                tight: Theme.phone;
                danger: true;
                visible: !root.none;
                nav: "delete";
                text: PlayView.delete-word;
                enabled: !root.none && PlayView.chosen >= 0;
            }
        }

        // The ways to play online, under the overview: HOST (main action while a build exists), ROOM LIST (enter a
        // room code to join or watch, or browse public rooms), and DIRECT CONNECT at the right edge (with the
        // reserved message line underneath).
        Arrive {
            order: 2;
            host := Button {
                x: Theme.phone ? 0px : root.side-x;
                y: root.host-y;
                width: Theme.phone ? root.body-width : Theme.sideways ? root.side-width : self.natural-width;
                nav: "invite";
                text: I18n.upper(@tr("Host"));
                kind: root.none ? ButtonKind.normal : ButtonKind.main;
                big: Theme.handheld;
            }

            rooms-btn := Button {
                x: Theme.phone ? 0px : Theme.sideways ? root.side-x : host.x + host.width + 16px;
                y: Theme.phone ? host.y + host.height + 12px : Theme.sideways ? root.code-y : root.row-y;
                width: Theme.phone ? root.body-width : Theme.sideways ? root.side-width : max(148px, self.natural-width);
                nav: "rooms";
                text: I18n.upper(@tr("Room list"));
            }

            // (A browser has no sockets of its own: links are WebRTC's alone, through the signaling server.)
            if !Theme.web: Button {
                x: Theme.phone ? 0px : root.body-width - self.width;
                y: Theme.phone ? rooms-btn.y + rooms-btn.height + 12px : Theme.sideways ? root.foot-y : root.row-y;
                width: Theme.phone ? root.body-width : self.natural-width;
                nav: "direct";
                // (Less than HOST and ROOM LIST: the user, "direct connect should be deemphasized".)
                kind: ButtonKind.text;
                text: I18n.upper(@tr("Direct connect"));
            }

            ProblemMark {
                x: Theme.phone ? 0px : root.side-x;
                y: root.line-y + (Theme.phone ? 6px : 6.5px);
                visible: PlayView.message-problem && PlayView.message != "";
            }

            Note {
                x: (Theme.phone ? 0px : root.side-x) + (PlayView.message-problem ? 9px : 0px);
                y: root.line-y;
                width: (Theme.phone ? root.body-width : Theme.sideways ? max(0px, (Theme.web ? root.body-width : root.body-width - 160px) - root.side-x - 8px) : root.side-width) - (PlayView.message-problem ? 9px : 0px);
                height: Theme.phone ? 40px : 18px;
                vertical-alignment: Theme.phone ? top : center;
                text: PlayView.message;
                color: PlayView.message-quiet ? Theme.muted : Theme.bad;
                font-size: 12px;
                wrap: Theme.phone ? word-wrap : no-wrap;
                overflow: elide;
            }
        }
    }

    // ---- The lobby: while the host waits for the other player, and with them ----
    // One layout from the moment an invite is out (or this machine hosts) for as long as the two players stay
    // together (the user: "you should unify the interface somehow between the waiting and the lobby"): the two
    // players' places side by side (on a phone one over the other), the match's settings and this player's own
    // apart beside them, the buttons, the reserved line. While the host waits, the other player's place has the
    // invite's code (`WaitCard`), the player's own the practice battle (on a phone their card, the battle asked for
    // with PRACTICE, filling the window), and the buttons are the way out alone; the match's settings are the
    // host's to set already (the user: "the host should be able to change settings before the joiner joins").
    if PlayView.part == PlayPart.lobby && !Theme.handheld: LobbyBody {
        x: 0;
        y: 0;
        width: root.body-width;
        height: root.body-height;
        viewport-height: root.body-height;
    }

    if PlayView.part == PlayPart.lobby && Theme.handheld: lobby-scroll := ScrollPage {
        x: 0;
        y: 0;
        width: root.body-width;
        height: root.body-height;
        nav: "lobby.";
        content-height: lobby-body.scroll-height;

        lobby-body := LobbyBody {
            x: 0;
            y: 0;
            width: lobby-scroll.view-width;
            height: max(root.body-height, self.scroll-height);
            viewport-height: root.body-height;
        }
    }

    // ---- Spectating another room live --------------------------------------------------------------------
    if PlayView.part == PlayPart.spectate: Rectangle {
        x: 0;
        y: 0;
        width: root.body-width;
        height: root.body-height;

        // Waiting in lobby / between sets
        if !PlayView.watch-in-battle: Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(parent.width, 520px);
            height: 260px;

            PanelBack { }

            Label {
                x: 24px;
                y: 22px;
                width: parent.width - 48px;
                height: 16px;
                text: PlayView.watch-game != "" ? "\{PlayView.watch-game} · \{PlayView.watch-code}" : PlayView.watch-code;
            }

            Value {
                x: 24px;
                y: 54px;
                width: parent.width - 48px;
                height: 28px;
                text: PlayView.watch-players != "" ? PlayView.watch-players : @tr("Connecting…");
                font-size: 20px;
            }

            Note {
                x: 24px;
                y: 94px;
                width: parent.width - 48px;
                height: 24px;
                text: PlayView.watch-problem != "" ? PlayView.watch-problem : PlayView.watch-stage;
                color: PlayView.watch-problem != "" ? Theme.bad : Theme.muted;
                wrap: word-wrap;
            }

            Note {
                x: 24px;
                y: 132px;
                width: parent.width - 48px;
                height: 20px;
                text: PlayView.watch-delay > 0 ? @tr("Anti-ghosting delay: {}s", PlayView.watch-delay) : @tr("Live (no delay)");
                color: Theme.dim;
            }

            settings-wait := Button {
                x: (parent.width - self.width - 12px - leave-wait.width) / 2;
                y: parent.height - self.height - 24px;
                nav: "watch.settings";
                text: I18n.upper(@tr("Settings"));
            }

            leave-wait := Button {
                x: settings-wait.x + settings-wait.width + 12px;
                y: settings-wait.y;
                nav: "watch.leave";
                text: I18n.upper(@tr("Leave"));
                kind: ButtonKind.ghost;
            }
        }

        // Active battle live view
        if PlayView.watch-in-battle: Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;

            Picture {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height - (Theme.phone ? 88px : 48px);
            }

            // Bottom spectator HUD bar (two compact rows on portrait phone; single row on sideways/desktop)
            Rectangle {
                property <length> seg-w: Theme.phone ? (parent.width - 28px) / 3 : 0px;
                x: 0;
                y: parent.height - (Theme.phone ? 84px : 44px);
                width: parent.width;
                height: Theme.phone ? 84px : 44px;

                PanelBack {
                    accent: false;
                }

                Mono {
                    x: Theme.phone ? 8px : 12px;
                    y: Theme.phone ? 4px : 0px;
                    width: Theme.phone ? 76px : 104px;
                    height: Theme.phone ? 36px : parent.height;
                    text: PlayView.watch-catching-up ? @tr("Catching up…") : PlayView.watch-delay > 0 ? @tr("DELAY {}s", PlayView.watch-delay) : @tr("LIVE");
                    color: PlayView.watch-catching-up ? Theme.cursor : Theme.good;
                }

                Note {
                    x: Theme.phone ? 88px : 120px;
                    y: Theme.phone ? 4px : 0px;
                    width: max(0px, (Theme.phone ? watch-settings-btn.x - 94px : view-p1.x - 130px));
                    height: Theme.phone ? 36px : parent.height;
                    text: PlayView.watch-players;
                    color: Theme.text;
                    wrap: no-wrap;
                    overflow: elide;
                }

                view-p1 := Button {
                    x: Theme.phone ? 8px : view-p2.x - self.width - 6px;
                    y: Theme.phone ? 44px : 6px;
                    width: Theme.phone ? parent.seg-w : self.natural-width;
                    height: Theme.phone ? 36px : 32px;
                    compact: true;
                    nav: "watch.view-p1";
                    kind: PlayView.watch-view == 0 ? ButtonKind.main : ButtonKind.ghost;
                    text: "P1";
                }

                view-p2 := Button {
                    x: Theme.phone ? 14px + parent.seg-w : view-both.x - self.width - 6px;
                    y: view-p1.y;
                    width: Theme.phone ? parent.seg-w : self.natural-width;
                    height: view-p1.height;
                    compact: true;
                    nav: "watch.view-p2";
                    kind: PlayView.watch-view == 1 ? ButtonKind.main : ButtonKind.ghost;
                    text: "P2";
                }

                view-both := Button {
                    x: Theme.phone ? 20px + 2 * parent.seg-w : watch-settings-btn.x - self.width - 10px;
                    y: view-p1.y;
                    width: Theme.phone ? parent.seg-w : self.natural-width;
                    height: view-p1.height;
                    compact: true;
                    nav: "watch.view-both";
                    kind: PlayView.watch-view == 2 ? ButtonKind.main : ButtonKind.ghost;
                    text: @tr("sides" => "Both");
                }

                watch-settings-btn := Button {
                    x: watch-leave-btn.x - self.width - 6px;
                    y: Theme.phone ? 4px : 6px;
                    width: Theme.phone ? 80px : self.natural-width;
                    height: Theme.phone ? 36px : 32px;
                    compact: true;
                    nav: "watch.settings";
                    kind: ButtonKind.ghost;
                    text: I18n.upper(@tr("Settings"));
                }

                watch-leave-btn := Button {
                    x: parent.width - self.width - (Theme.phone ? 8px : 10px);
                    y: Theme.phone ? 4px : 6px;
                    width: Theme.phone ? 70px : self.natural-width;
                    height: Theme.phone ? 36px : 32px;
                    compact: true;
                    nav: "watch.leave";
                    kind: ButtonKind.ghost;
                    text: I18n.upper(@tr("Leave"));
                }
            }
        }
    }
}

// ---- Over the match --------------------------------------------------------------------------------------

// The match menu: Start or Esc in an online match, in place of the game's own pause. The match keeps running
// behind it. Its pages are the menu itself, and what two of its items open: the controls, the settings a player
// may want in a match. Its footer lists the match's own controls as this player's bindings have them (the user:
// "the menu footer should show in-game controls"), and Tab (Select on a pad) shows both builds over it as in the
// match.
export component MatchMenu inherits MenuOverlay {
    property <[string]> actions: [@tr("Up"), @tr("Down"), @tr("Left"), @tr("Right"), "A", "B", "L", "R", "START", "SELECT", @tr("Navi change left"), @tr("Navi change right"), @tr("Quick shout")];
    title: PlayView.page == MatchPage.controls ? I18n.upper(@tr("Controls")) : PlayView.page == MatchPage.settings ? I18n.upper(@tr("Settings")) : I18n.upper(@tr("Menu"));
    note: PlayView.page == MatchPage.menu ? (PlayView.watch-menu ? "" : @tr("The match keeps running")) : "";
    side: PlayView.page != MatchPage.menu;
    content-height: PlayView.watch-menu ? 144px : 192px;
    hints: PlayView.watch-menu ? [] : PlayView.match-keys;
    if PlayView.page == MatchPage.menu: Rectangle {
        x: 0;
        y: 0;
        width: root.inner-width;
        height: root.inner-height;
        MenuItem {
            x: 0;
            y: 0;
            width: root.inner-width;
            nav: "menu.resume";
            text: PlayView.watch-menu ? I18n.upper(@tr("Back to spectate")) : I18n.upper(@tr("Back to match"));
        }

        if !PlayView.watch-menu: MenuItem {
            x: 0;
            y: 48px;
            width: root.inner-width;
            nav: "menu.controls";
            text: I18n.upper(@tr("Controls"));
        }

        MenuItem {
            x: 0;
            y: PlayView.watch-menu ? 48px : 96px;
            width: root.inner-width;
            nav: "menu.settings";
            text: I18n.upper(@tr("Settings"));
        }

        MenuItem {
            x: 0;
            y: PlayView.watch-menu ? 96px : 144px;
            width: root.inner-width;
            nav: "menu.leave";
            text: PlayView.watch-menu ? I18n.upper(@tr("Leave")) : I18n.upper(@tr("Leave match"));
            danger: true;
        }
    }

    // What is bound to each of the battle's buttons, each to change as the Settings screen's controls change
    // (Enter on a box, then the key or the pad's button), and RESET CONTROLS beside Back. The match goes on under it
    // and plays by the bindings as they change.
    if PlayView.page == MatchPage.controls: Rectangle {
        x: 0;
        y: 0;
        width: root.inner-width;
        height: root.inner-height;
        Label {
            x: root.inner-width - 232px;
            y: 0;
            width: 110px;
            height: 20px;
            text: I18n.upper(@tr("Key"));
        }

        Label {
            x: root.inner-width - 110px;
            y: 0;
            width: 110px;
            height: 20px;
            text: I18n.upper(@tr("Pad"));
        }

        // (The rows scroll where the panel is too short for them all, a phone's held sideways: their page's bar is in
        // the panel's margin, so they are the panel's width either way.)
        ScrollPage {
            x: 0;
            y: 24px;
            width: root.inner-width + 12px;
            height: max(0px, root.inner-height - 24px - 52px);
            nav: "menu.keys.";
            content-height: root.actions.length * 44px - 4px;
            for action[i] in root.actions: Rectangle {
                x: 0;
                y: i * 44px;
                width: root.inner-width;
                height: 40px;
                Value {
                    x: 0;
                    width: parent.width - 244px;
                    text: action;
                }

                BindBox {
                    x: parent.width - 232px;
                    width: 110px;
                    nav: "menu.keys.key";
                    nav-index: i;
                    value: SettingsView.keys[i];
                    asking: SettingsView.asking-key == i;
                    ask: @tr("Key or click");
                }

                BindBox {
                    x: parent.width - 110px;
                    width: 110px;
                    nav: "menu.keys.button";
                    nav-index: i;
                    value: SettingsView.buttons[i].text;
                    face: SettingsView.buttons[i].face;
                    asking: SettingsView.asking-button == i;
                    ask: @tr("Press a button");
                }
            }
        }

        Button {
            x: 0;
            y: root.inner-height - 40px;
            nav: "menu.back";
            text: I18n.upper(@tr("Back"));
        }

        Button {
            x: root.inner-width - self.width;
            y: root.inner-height - 40px;
            nav: "menu.reset";
            text: I18n.upper(@tr("Reset controls"));
        }
    }

    // The settings a player may want in a match, as the Settings screen has them: the language, the picture's size,
    // full screen, the graphics enhancements, the sound's two levels and their input delay. Each changes at once, the
    // match's picture and sound with it. On a phone each label is over its control.
    if PlayView.page == MatchPage.settings: settings-page := Rectangle {
        x: 0;
        y: 0;
        width: root.inner-width;
        height: root.inner-height;
        property <length> pitch: Theme.phone ? 66px : 48px;
        // Where a row's control is, under its label on a phone.
        property <length> below: Theme.phone ? 20px : 0px;
        property <length> control-x: Theme.phone ? 0px : root.inner-width - 232px;
        property <length> control-width: Theme.phone ? root.inner-width : 232px;
        property <length> label-width: Theme.phone ? root.inner-width : root.inner-width - 244px;
        property <length> label-height: Theme.phone ? 20px : 44px;
        // (The rows scroll where the panel is too short for them all, as the controls' do.)
        ScrollPage {
            x: 0;
            y: 0;
            width: root.inner-width + 12px;
            height: max(0px, root.inner-height - 52px);
            nav: "menu.set.";
            content-height: (PlayView.watch-menu ? 12 : 14) * settings-page.pitch;
            for label[i] in [@tr("Language"), @tr("Picture size"), @tr("Full screen"), @tr("Reduce flashes"), @tr("Hide aura number"), @tr("Sharp text"), @tr("Sharp HUD"), @tr("Smooth motion"), @tr("Fill the window"), @tr("HD chip art"), @tr("Music"), @tr("Sound effects")]: Value {
                x: 0;
                y: i * settings-page.pitch;
                width: settings-page.label-width;
                height: settings-page.label-height;
                text: label;
            }

            Value {
                x: 0;
                y: 12 * settings-page.pitch;
                width: settings-page.label-width;
                height: settings-page.label-height;
                visible: !PlayView.watch-menu;
                text: @tr("Input delay");
            }

            Value {
                x: 0;
                y: 13 * settings-page.pitch;
                width: settings-page.label-width;
                height: settings-page.label-height;
                visible: !PlayView.watch-menu;
                text: @tr("Keyboard-only custom screen");
            }

            Select {
                x: settings-page.control-x;
                y: settings-page.below + 2px;
                width: settings-page.control-width;
                nav: "menu.set.language";
                value: SettingsView.language;
            }

            Select {
                x: settings-page.control-x;
                y: settings-page.pitch + settings-page.below + 2px;
                width: settings-page.control-width;
                nav: "menu.set.picture";
                value: SettingsView.picture-size == "" ? SettingsView.largest : SettingsView.picture-size;
            }

            Seg {
                x: settings-page.control-x;
                y: 2 * settings-page.pitch + settings-page.below + 4px;
                nav: "menu.set.fullscreen";
                first: I18n.upper(@tr("Off"));
                second: I18n.upper(@tr("On"));
                chosen: SettingsView.full-screen ? 1 : 0;
            }

            Seg {
                x: settings-page.control-x;
                y: 3 * settings-page.pitch + settings-page.below + 4px;
                nav: "menu.set.reduce-flashes";
                first: I18n.upper(@tr("Off"));
                second: I18n.upper(@tr("On"));
                chosen: SettingsView.reduce-flashes ? 1 : 0;
            }

            Seg {
                x: settings-page.control-x;
                y: 4 * settings-page.pitch + settings-page.below + 4px;
                nav: "menu.set.hide-aura-number";
                first: I18n.upper(@tr("Off"));
                second: I18n.upper(@tr("On"));
                chosen: SettingsView.hide-aura-number ? 1 : 0;
            }

            Seg {
                x: settings-page.control-x;
                y: 5 * settings-page.pitch + settings-page.below + 4px;
                nav: "menu.set.text";
                first: I18n.upper(@tr("Off"));
                second: I18n.upper(@tr("On"));
                chosen: SettingsView.sharp-text ? 1 : 0;
            }

            Seg {
                x: settings-page.control-x;
                y: 6 * settings-page.pitch + settings-page.below + 4px;
                nav: "menu.set.hud";
                first: I18n.upper(@tr("Off"));
                second: I18n.upper(@tr("On"));
                chosen: SettingsView.sharp-hud ? 1 : 0;
            }

            Seg {
                x: settings-page.control-x;
                y: 7 * settings-page.pitch + settings-page.below + 4px;
                nav: "menu.set.smooth";
                first: I18n.upper(@tr("Off"));
                second: I18n.upper(@tr("On"));
                chosen: SettingsView.smooth-motion ? 1 : 0;
            }

            Seg {
                x: settings-page.control-x;
                y: 8 * settings-page.pitch + settings-page.below + 4px;
                nav: "menu.set.fill";
                first: I18n.upper(@tr("Off"));
                second: I18n.upper(@tr("On"));
                chosen: SettingsView.fill-window ? 1 : 0;
            }

            Seg {
                x: settings-page.control-x;
                y: 9 * settings-page.pitch + settings-page.below + 4px;
                nav: "menu.set.hd-chip-art";
                first: I18n.upper(@tr("Off"));
                second: I18n.upper(@tr("On"));
                chosen: SettingsView.hd-chip-art ? 1 : 0;
            }

            Slider {
                x: settings-page.control-x;
                y: 10 * settings-page.pitch + settings-page.below + 2px;
                width: settings-page.control-width;
                nav: "menu.set.music";
                value: PlayView.music;
            }

            Slider {
                x: settings-page.control-x;
                y: 11 * settings-page.pitch + settings-page.below + 2px;
                width: settings-page.control-width;
                nav: "menu.set.effects";
                value: PlayView.effects;
            }

            Stepper {
                x: Theme.phone ? 0px : root.inner-width - self.width;
                y: 12 * settings-page.pitch + settings-page.below + 4px;
                visible: !PlayView.watch-menu;
                enabled: !PlayView.watch-menu;
                nav: "menu.set.delay";
                value: PlayView.input-delay;
                value-width: 48px;
                numeric: true;
            }

            Seg {
                x: settings-page.control-x;
                y: 13 * settings-page.pitch + settings-page.below + 4px;
                visible: !PlayView.watch-menu;
                enabled: !PlayView.watch-menu;
                nav: "menu.set.keyboard-only";
                first: I18n.upper(@tr("Off"));
                second: I18n.upper(@tr("On"));
                chosen: SettingsView.keyboard-only-custom ? 1 : 0;
            }
        }

        Button {
            x: 0;
            y: root.inner-height - 40px;
            nav: "menu.back";
            text: I18n.upper(@tr("Back"));
        }
    }
}

// The wheel and a drag over one of the builds over the match (`MatchPeek`): both scroll, by `PlayView.peek-y`.
component Scrub inherits TouchArea {
    property <length> held-at;
    scroll-event(e) => {
        PlayView.peek-y = clamp(PlayView.peek-y + e.delta-y, -PlayView.peek-span, 0px);
        return accept;
    }
    pointer-event(e) => {
        if e.kind == PointerEventKind.down {
            self.held-at = PlayView.peek-y;
        }
    }
    moved => {
        PlayView.peek-y = clamp(self.held-at + self.mouse-y - self.pressed-y, -PlayView.peek-span, 0px);
    }
}

// Both builds, over the match while Tab (Select on a pad) is held, and so over the match menu: the player's on their
// side, the other player's on theirs; where the setups aren't open, the player's own alone. Each is the narrow sheet,
// the whole build (its partners' programs, its NaviCust, patch cards and auto battle data among its parts), as tall as
// they make it; where one is taller than its box (the window less the margins; on a phone half of it)
// they scroll together, by the wheel and a drag over them, and while the menu is open by the keys and the pad
// (`Play::scroll`). It takes no keys: the match goes on under it.
export component MatchPeek inherits Rectangle {
    // (Sideways each half the window, less the gap between them.)
    property <length> sheet-width: Theme.sideways ? (self.width - 12px) / 2 : min(430px, self.width - 2 * Theme.margin);
    // (Over the menu they leave its footer in view.)
    property <length> room: self.height - 2 * Theme.margin - (Shell.battle-menu ? Theme.footer : 0px);
    property <length> half: (root.room - Theme.margin) / 2;
    property <length> theirs-x: Theme.phone ? Theme.margin : self.width - Theme.margin - root.sheet-width;
    property <length> theirs-y: Theme.phone ? 2 * Theme.margin + root.half : Theme.margin;
    if PlayView.peek: Rectangle {
        property <length> mine-box: Theme.phone ? root.half : min(mine.sheet-height, root.room);
        property <length> theirs-box: Theme.phone ? root.half : min(theirs.sheet-height, root.room);
        property <length> mine-span: max(0px, mine.sheet-height - self.mine-box);
        property <length> theirs-span: PlayView.open-match ? max(0px, theirs.sheet-height - self.theirs-box) : 0px;
        property <length> span: max(self.mine-span, self.theirs-span);
        property <length> view: PlayView.open-match ? min(self.mine-box, self.theirs-box) : self.mine-box;
        init => {
            PlayView.peek-span = self.span;
            PlayView.peek-view = self.view;
        }
        changed span => {
            PlayView.peek-span = self.span;
            PlayView.peek-y = clamp(PlayView.peek-y, -self.span, 0px);
        }
        changed view => {
            PlayView.peek-view = self.view;
        }
        Rectangle {
            x: Theme.margin;
            y: Theme.margin;
            width: root.sheet-width;
            height: parent.mine-box;
            clip: true;
            mine := BuildOverview {
                x: 0;
                y: max(PlayView.peek-y, min(0px, parent.height - self.sheet-height));
                width: root.sheet-width;
                height: self.sheet-height;
                build: PlayView.mine;
                side: 1;
            }

            Scrub { }
        }

        Rectangle {
            x: root.theirs-x;
            y: root.theirs-y;
            width: root.sheet-width;
            height: parent.theirs-box;
            clip: true;
            visible: PlayView.open-match;
            theirs := BuildOverview {
                x: 0;
                y: max(PlayView.peek-y, min(0px, parent.height - self.sheet-height));
                width: root.sheet-width;
                height: self.sheet-height;
                build: PlayView.theirs;
                side: 2;
            }

            Scrub { }
        }

        // Where each is, as a thumb along its right edge.
        Rectangle {
            x: Theme.margin + root.sheet-width - 4px;
            y: Theme.margin + parent.mine-box * (-mine.y) / max(1px, mine.sheet-height);
            width: 4px;
            height: parent.mine-box * parent.mine-box / max(1px, mine.sheet-height);
            visible: parent.mine-span > 0.5px;
            background: Theme.line;
        }

        Rectangle {
            x: root.theirs-x + root.sheet-width - 4px;
            y: root.theirs-y + parent.theirs-box * (-theirs.y) / max(1px, theirs.sheet-height);
            width: 4px;
            height: parent.theirs-box * parent.theirs-box / max(1px, theirs.sheet-height);
            visible: parent.theirs-span > 0.5px && PlayView.open-match;
            background: Theme.line;
        }
    }
}

// How the match went (docs/design/app-ui.md §6, "After a match"; §2.49), over the picture once its set is over:
// the winner's half of the window floods with their side's color (the player's own, on the left, in player
// one's red; the other's in player two's blue), sweeping in from its outer edge; WIN or LOSE stamps in, centered
// on the player's own half; then the rounds' score and the match's time count up, one after another, each number
// in a box of one width. CONTINUE (Enter, the pad's A) settles it where it still moves, and then goes on to the
// lobby (the app's: `result.go`); it goes on by itself after a few seconds. With motion turned down it is there at
// once. On a phone the halves are the window's top (the player's) and bottom.
export component MatchResult inherits Rectangle {
    property <bool> won: PlayView.outcome == MatchOutcome.won;
    property <bool> lost: PlayView.outcome == MatchOutcome.lost;
    property <color> tone: root.won ? Theme.p1 : Theme.p2;
    property <length> half-width: Theme.phone ? self.width : self.width / 2;
    property <length> half-height: Theme.phone ? self.height / 2 : self.height;
    // The player's own half's middle: the word, and the numbers under it.
    property <length> mid-x: root.half-width / 2;
    property <length> mid-y: root.half-height / 2;
    property <length> stats-width: Theme.handheld ? 300px : 360px;
    property <length> digits: Theme.handheld ? 28px : 34px;
    // One after another, by the theme's table: the flood, the word, the score, then the time to the set piece's
    // end.
    flood := Tween {
        settled: PlayView.result-settled;
    }

    stamp := Tween {
        delay: Theme.quick;
        duration: Theme.brisk;
        settled: PlayView.result-settled;
    }

    // (It takes the clicks meant for the battle under it.)
    TouchArea { }

    // The picture under it, dimmed.
    Rectangle {
        background: Theme.ground-bottom.with-alpha(0.8);
    }

    // The winner's half, flooding in from its outer edge (the window's) toward the middle, a lit edge leading.
    Rectangle {
        x: Theme.phone || root.won ? 0px : root.half-width;
        y: !Theme.phone || root.won ? 0px : root.half-height;
        width: root.half-width;
        height: root.half-height;
        visible: root.won || root.lost;
        clip: true;
        Rectangle {
            property <float> way: root.won ? -1 : 1;
            x: Theme.phone ? 0px : (1 - flood.t) * root.half-width * self.way;
            y: !Theme.phone ? 0px : (1 - flood.t) * root.half-height * self.way;
            background: Theme.phone ? @linear-gradient(root.won ? 180deg : 0deg, root.tone.with-alpha(0.62) 0%, root.tone.with-alpha(0.28) 100%) : @linear-gradient(root.won ? 90deg : 270deg, root.tone.with-alpha(0.62) 0%, root.tone.with-alpha(0.28) 100%);
            Rectangle {
                x: Theme.phone || !root.won ? 0px : parent.width - 2px;
                y: !Theme.phone || !root.won ? 0px : parent.height - 2px;
                width: Theme.phone ? parent.width : 2px;
                height: Theme.phone ? 2px : parent.height;
                background: root.tone.brighter(0.4);
                drop-shadow-blur: 16px;
                drop-shadow-color: root.tone;
            }
        }
    }

    // WIN, LOSE or DRAW, stamped in on the player's own half.
    Text {
        property <bool> over: Theme.audit && self.preferred-width > self.width + 0.5px;
        x: Theme.margin;
        y: root.mid-y - (Theme.handheld ? 100px : 140px);
        width: root.half-width - 2 * Theme.margin;
        height: Theme.handheld ? 92px : 150px;
        text: root.won ? I18n.upper(@tr("Win")) : root.lost ? I18n.upper(@tr("Lose")) : I18n.upper(@tr("Draw"));
        color: root.lost ? Theme.muted : Theme.text;
        font-family: Theme.display;
        font-size: Theme.handheld ? 60px : 104px;
        font-weight: Theme.display-bold;
        letter-spacing: Theme.title-tracking * 2;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
        opacity: stamp.linear;
        transform-scale: 1 + (1 - stamp.t) * 0.8;
        changed over => {
            if over {
                Audit.clipped(self.text);
            }
        }
    }

    // The rounds' score and the match's time, each label over its number.
    Rectangle {
        x: root.mid-x - root.stats-width / 2;
        y: root.mid-y + (Theme.handheld ? 4px : 30px);
        width: root.stats-width;
        height: 64px;
        Label {
            x: 0;
            y: 0;
            width: parent.width / 2 - 8px;
            height: 14px;
            text: I18n.upper(@tr("Rounds"));
            horizontal-alignment: center;
        }

        // (Each side's wins in a box of two digits, the dash between them where it is.)
        Count {
            x: parent.width / 4 - 16px - self.width;
            y: 22px;
            width: 48px;
            height: 40px;
            value: PlayView.result-wins;
            from-zero: true;
            delay: Theme.quick + Theme.brisk;
            duration: Theme.quick;
            settled: PlayView.result-settled;
            font-size: root.digits;
            horizontal-alignment: right;
            ticked => {
                PlayView.result-ticks += 1;
            }
        }

        Text {
            x: parent.width / 4 - 16px;
            y: 22px;
            width: 32px;
            height: 40px;
            text: "–";
            color: Theme.muted;
            font-family: Theme.mono;
            font-size: root.digits;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        Count {
            x: parent.width / 4 + 16px;
            y: 22px;
            width: 48px;
            height: 40px;
            value: PlayView.result-losses;
            from-zero: true;
            delay: Theme.quick + Theme.brisk;
            duration: Theme.quick;
            settled: PlayView.result-settled;
            font-size: root.digits;
            horizontal-alignment: left;
            ticked => {
                PlayView.result-ticks += 1;
            }
        }

        Label {
            x: parent.width / 2 + 8px;
            y: 0;
            width: parent.width / 2 - 8px;
            height: 14px;
            text: I18n.upper(@tr("Time"));
            horizontal-alignment: center;
        }

        time := Count {
            x: parent.width / 2 + 8px;
            y: 22px;
            width: parent.width / 2 - 8px;
            height: 40px;
            value: PlayView.result-time;
            clock: true;
            from-zero: true;
            delay: 2 * Theme.quick + Theme.brisk;
            duration: Theme.set-piece - 2 * Theme.quick - Theme.brisk;
            settled: PlayView.result-settled;
            font-size: root.digits;
            horizontal-alignment: center;
            ticked => {
                PlayView.result-ticks += 1;
            }
            changed done => {
                if self.done {
                    PlayView.result-done = true;
                }
            }
        }
    }

    if PlayView.result-abd-lines.length > 0: Rectangle {
        property <length> card-w: Theme.phone ? root.width - 2 * Theme.margin : min(440px, root.half-width - 2 * Theme.margin);
        property <length> card-h: min(Theme.phone ? root.height - root.half-height - Theme.margin - 64px : root.height - 96px, abd-col.preferred-height + 24px);
        x: Theme.phone ? Theme.margin : root.half-width + (root.half-width - self.card-w) / 2;
        y: Theme.phone ? root.half-height + 8px : (root.height - self.card-h) / 2;
        width: self.card-w;
        height: self.card-h;
        background: Theme.ground-top.with-alpha(0.88);
        border-width: 1px;
        border-color: Theme.line;
        border-radius: 6px;
        clip: true;

        abd-col := VerticalLayout {
            x: 14px;
            y: 12px;
            width: parent.width - 28px;
            spacing: 6px;

            Label {
                text: I18n.upper(@tr("ABD Chip Usage"));
                color: Theme.muted;
            }

            Text {
                text: PlayView.result-abd-header;
                color: Theme.cursor;
                font-family: Theme.body;
                font-size: 13px;
                font-weight: 700;
                wrap: word-wrap;
            }

            for line in PlayView.result-abd-lines: Text {
                text: line;
                color: Theme.text;
                font-family: Theme.body;
                font-size: Theme.handheld ? 11px : 12px;
                wrap: word-wrap;
            }
        }
    }

    Button {
        x: Theme.phone ? Theme.margin : root.mid-x - self.width / 2;
        y: root.height - (Theme.phone ? Theme.margin : 48px) - self.height;
        width: Theme.phone ? root.width - 2 * Theme.margin : max(200px, self.natural-width);
        nav: "result.go";
        text: I18n.upper(@tr("Continue"));
        kind: ButtonKind.main;
    }

    // (Where it is there at once, its last number is too.)
    init => {
        if time.done {
            PlayView.result-done = true;
        }
    }
}

// ---- Over the screen -------------------------------------------------------------------------------------

// A new build's name and version. Its controls' names begin with `name.`. Under its buttons, below a line, is the
// other way to start one: FROM A SAVE FILE…, which opens the system's file dialog (the build is made of the save,
// named for its file). (A build is renamed in the editor, its header's name a field: docs/design/app-ui.md §2.74.)
component NameDialog inherits DialogFrame {
    // (Its name, its version and the version's note, each under its label, then the buttons. On a phone held
    // sideways, too short for FROM A SAVE FILE… under a line, it is a little wider than the desktop's with that at
    // the buttons' left.)
    property <length> version-y: 100px;
    property <length> note-y: root.version-y + Theme.control + 8px;
    property <length> buttons-y: root.note-y + 38px + 16px;
    title: I18n.upper(@tr("title" => "New build"));
    wide: true;
    panel-width: Theme.sideways ? 600px : 540px;
    content-height: root.buttons-y + (Theme.sideways ? 40px : 120px);
    Label {
        x: 0;
        y: 0;
        width: root.inner-width;
        height: 14px;
        text: I18n.upper(@tr("Name"));
    }

    Field {
        x: 0;
        y: 22px;
        width: root.inner-width;
        nav: "name.name";
        text: PlayView.dialog-name;
    }

    Label {
        x: 0;
        y: 78px;
        width: root.inner-width;
        height: 14px;
        text: I18n.upper(@tr("Version"));
    }

    VersionChoice {
        x: 0;
        y: root.version-y;
        width: root.inner-width;
        versions: PlayView.versions;
        chosen: PlayView.dialog-version;

        Rectangle { }  // (Copied in: docs/app.md §14.)
    }

    Note {
        x: 0;
        y: root.note-y;
        width: root.inner-width;
        height: 38px;
        text: @tr("{} They can be changed later in the editor.", PlayView.version-sets);
    }

    confirm := Button {
        x: root.inner-width - self.width;
        y: root.buttons-y;
        nav: "name.confirm";
        text: I18n.upper(@tr("Create build"));
        kind: ButtonKind.main;
        enabled: PlayView.dialog-name != "";
    }

    Button {
        x: confirm.x - 12px - self.width;
        y: root.buttons-y;
        nav: "name.cancel";
        text: I18n.upper(@tr("Cancel"));
        kind: ButtonKind.ghost;
    }

    Rule {
        x: 0;
        y: root.buttons-y + 64px;
        width: root.inner-width;
        visible: !Theme.sideways;

        Rectangle { }  // (Copied in: docs/app.md §14.)
    }

    Button {
        x: 0;
        y: root.buttons-y + (Theme.sideways ? 0px : 80px);
        nav: "name.save";
        text: I18n.upper(@tr("From a save file…"));
        kind: ButtonKind.ghost;
    }
}

// What opens over Play: a build's name, a direct connection's dialog, the code's boxes, and the lobby's list of
// builds to change to. It covers the whole window, over the screen and under the shell's own dialogs; empty, it
// takes no clicks.
export component PlayOverlay inherits Rectangle {
    if PlayView.dialog != BuildDialog.none: NameDialog {
        Rectangle { }  // (Copied in: docs/app.md §14.)
    }

    // Unified room list browser (enter a code to join/watch, or browse/join/watch public rooms).
    if PlayView.room-browser: rooms := DialogFrame {
        property <length> row-height: Theme.phone ? 94px : 60px;
        property <length> row-pitch: self.row-height + 6px;
        property <length> list-y: Theme.sideways ? 118px : Theme.phone ? 210px : 138px;
        property <length> list-height: Theme.sideways ? 108px : Theme.phone ? 240px : 268px;
        title: @tr("Room list");
        wide: true;
        panel-width: 640px;
        content-height: self.list-y + self.list-height + 48px;

        Label {
            x: 0;
            y: 0;
            width: rooms.inner-width;
            height: 14px;
            text: I18n.upper(@tr("Room code"));
        }

        Field {
            x: 0;
            y: Theme.sideways ? 18px : 22px;
            width: Theme.phone ? rooms.inner-width : rooms.inner-width - code-join.width - code-watch.width - 16px;
            nav: "rooms.code";
            text: PlayView.room-code;
            placeholder: @tr("Invite code");
            code: true;
            error: PlayView.room-error != "" && !PlayView.room-quiet;
        }

        code-join := Button {
            x: Theme.phone ? 0px : code-watch.x - self.width - 8px;
            y: Theme.phone ? 70px : Theme.sideways ? 18px : 22px;
            width: Theme.phone ? (rooms.inner-width - 8px) / 2 : max(92px, self.natural-width);
            nav: "rooms.join-code";
            text: I18n.upper(@tr("Join"));
            kind: ButtonKind.main;
        }

        code-watch := Button {
            x: Theme.phone ? code-join.width + 8px : rooms.inner-width - self.width;
            y: Theme.phone ? 70px : Theme.sideways ? 18px : 22px;
            width: Theme.phone ? (rooms.inner-width - 8px) / 2 : max(92px, self.natural-width);
            nav: "rooms.watch-code";
            text: I18n.upper(@tr("spectate" => "Watch"));
        }

        Message {
            x: 0;
            y: Theme.sideways ? 60px : Theme.phone ? 114px : 66px;
            width: rooms.inner-width;
            text: PlayView.room-error;
            tone: PlayView.room-quiet ? Theme.muted : Theme.bad;
        }

        Rule {
            x: 0;
            y: Theme.sideways ? 78px : Theme.phone ? 136px : 90px;
            width: rooms.inner-width;

            Rectangle { }
        }

        Label {
            x: 0;
            y: Theme.sideways ? 84px : Theme.phone ? 144px : 104px;
            width: Theme.phone ? rooms.inner-width : max(0px, rooms-filter.x - 8px);
            height: 20px;
            text: I18n.upper(@tr("Public rooms"));
        }

        rooms-filter := Button {
            x: Theme.phone ? 0px : rooms-refresh.x - self.width - 8px;
            y: Theme.phone ? 166px : Theme.sideways ? 82px : 98px;
            width: Theme.phone ? (rooms.inner-width - 8px) / 2 : self.natural-width;
            height: Theme.phone ? 36px : 30px;
            compact: true;
            nav: "rooms.filter";
            kind: PlayView.room-filter-current ? ButtonKind.main : ButtonKind.ghost;
            text: PlayView.room-filter-current ? Shell.game : I18n.upper(@tr("All games"));
        }

        rooms-refresh := Button {
            x: Theme.phone ? rooms-filter.width + 8px : rooms.inner-width - self.width;
            y: Theme.phone ? 166px : Theme.sideways ? 82px : 98px;
            width: Theme.phone ? (rooms.inner-width - 8px) / 2 : self.natural-width;
            height: Theme.phone ? 36px : 30px;
            compact: true;
            nav: "rooms.refresh";
            kind: ButtonKind.ghost;
            text: I18n.upper(@tr("Refresh"));
        }

        Rectangle {
            x: 0;
            y: rooms.list-y;
            width: rooms.inner-width;
            height: rooms.list-height;

            if PlayView.room-entries.length == 0: Note {
                x: 0;
                y: 0;
                width: parent.width;
                height: parent.height;
                horizontal-alignment: center;
                vertical-alignment: center;
                text: PlayView.room-loading ? @tr("Loading rooms…") : @tr("No public rooms right now.");
                color: Theme.muted;
            }

            if PlayView.room-entries.length > 0: rooms-scroll := ScrollPage {
                width: parent.width;
                height: parent.height;
                nav: "rooms.list.";
                content-height: max(0px, PlayView.room-entries.length * rooms.row-pitch - 6px);
                for entry[i] in PlayView.room-entries: Rectangle {
                    x: 0;
                    y: i * rooms.row-pitch;
                    width: rooms-scroll.view-width;
                    height: rooms.row-height;
                    property <length> actions-w: Theme.phone ? 12px : (entry.joinable ? row-join.width + row-watch.width + 26px : row-watch.width + 18px);
                    property <string> stage-text: entry.stage == 0 ? @tr("Waiting") : entry.stage == 2 ? @tr("Loading") : entry.stage == 3 ? @tr("Playing") : @tr("Lobby");

                    Rectangle {
                        background: Theme.inset;
                        border-width: 1px;
                        border-color: entry.joinable && entry.same-game ? Theme.line : Theme.line.with-alpha(0.65);
                    }

                    // Left status bar: green for joinable waiting room, cyan for playing, dim otherwise.
                    Rectangle {
                        x: 0;
                        y: 0;
                        width: 3px;
                        height: parent.height;
                        background: entry.joinable ? Theme.good : entry.stage == 3 ? Theme.cursor : Theme.dim;
                    }

                    Value {
                        x: 12px;
                        y: 6px;
                        width: max(0px, parent.width - self.x - parent.actions-w - stage-lbl.width - 8px);
                        height: 22px;
                        text: entry.joinable ? entry.host : entry.players;
                        font-size: 14px;
                    }

                    stage-lbl := Label {
                        x: parent.width - parent.actions-w - self.width - (Theme.phone ? 0px : 8px);
                        y: 6px;
                        width: min(88px, self.preferred-width);
                        height: 22px;
                        horizontal-alignment: right;
                        text: I18n.upper(parent.stage-text);
                        color: entry.joinable ? Theme.good : entry.stage == 3 ? Theme.cursor : Theme.muted;
                        font-size: 11px;
                    }

                    Note {
                        x: 12px;
                        y: 29px;
                        width: max(0px, parent.width - self.x - parent.actions-w - spec-lbl.width - 8px);
                        height: 18px;
                        text: entry.rules != "" ? "\{entry.game} · \{entry.code} · \{entry.rules}" : "\{entry.game} · \{entry.code}";
                        color: entry.same-game ? Theme.text : Theme.muted;
                        font-size: 11px;
                        wrap: no-wrap;
                        overflow: elide;
                    }

                    spec-lbl := Note {
                        x: parent.width - parent.actions-w - self.width - (Theme.phone ? 0px : 8px);
                        y: 29px;
                        width: min(96px, self.preferred-width);
                        height: 18px;
                        horizontal-alignment: right;
                        text: entry.delay > 0 ? @tr("{} · {}s", entry.spectators, entry.delay) : @tr("{} watching", entry.spectators);
                        color: Theme.dim;
                        font-size: 11px;
                        wrap: no-wrap;
                        overflow: elide;
                    }

                    row-join := Button {
                        x: Theme.phone ? 12px : parent.width - row-watch.width - self.width - 18px;
                        y: Theme.phone ? 52px : 14px;
                        width: Theme.phone ? (parent.width - 32px) / 2 : max(80px, self.natural-width);
                        height: Theme.phone ? 34px : 32px;
                        compact: true;
                        visible: entry.joinable;
                        enabled: entry.joinable;
                        nav: "rooms.list.join";
                        nav-index: i;
                        kind: entry.same-game ? ButtonKind.main : ButtonKind.normal;
                        text: I18n.upper(@tr("Join"));
                    }

                    row-watch := Button {
                        x: Theme.phone ? (entry.joinable ? row-join.x + row-join.width + 8px : 12px) : parent.width - self.width - 10px;
                        y: Theme.phone ? 52px : 14px;
                        width: Theme.phone ? (entry.joinable ? (parent.width - 32px) / 2 : parent.width - 24px) : max(80px, self.natural-width);
                        height: Theme.phone ? 34px : 32px;
                        compact: true;
                        nav: "rooms.list.watch";
                        nav-index: i;
                        kind: entry.joinable ? ButtonKind.ghost : ButtonKind.normal;
                        text: I18n.upper(@tr("spectate" => "Watch"));
                    }
                }
            }
        }

        Button {
            x: rooms.inner-width - self.width;
            y: rooms.list-y + rooms.list-height + 8px;
            nav: "rooms.close";
            text: I18n.upper(@tr("Close"));
            kind: ButtonKind.ghost;
        }
    }


    // A direct connection: host, with this machine's address to send; or join, by the host's address.
    if PlayView.direct: direct := DialogFrame {
        // (On a phone each button is under its box: an address needs the dialog's width. Held sideways, too short
        // for that, the desktop's.)
        property <length> under: Theme.phone ? 48px : 0px;
        title: @tr("Direct connection");
        wide: true;
        content-height: 252px + 2 * self.under;
        Label {
            x: 0;
            y: 0;
            width: direct.inner-width;
            height: 14px;
            text: I18n.upper(@tr("Host"));
        }

        // This machine's address: Enter copies it.
        Rectangle {
            x: 0;
            y: 22px;
            width: Theme.phone ? direct.inner-width : direct.inner-width - host.width - 8px;
            height: 40px;
            Rectangle {
                background: Theme.inset;
                border-width: 1px;
                border-color: copy.has-hover ? Theme.muted : Theme.line;
            }

            Mono {
                x: 12px;
                width: parent.width - 36px - word.width;
                text: PlayView.host-address;
            }

            word := Label {
                x: parent.width - 12px - self.width;
                width: self.preferred-width;
                text: I18n.upper(@tr("Copy"));
            }

            Flash {
                seq: PlayView.copied-seq;

                Rectangle { }  // (Copied in: docs/app.md §14.)
            }

            copy := Focusable {
                nav: "direct.copy";
            }
        }

        host := Button {
            x: direct.inner-width - self.width;
            y: 22px + direct.under;
            width: Theme.phone ? direct.inner-width : self.natural-width;
            nav: "direct.host";
            text: I18n.upper(@tr("Host"));
            kind: ButtonKind.main;
        }

        // One line: what to do with the address, or why this machine can't host.
        Note {
            x: 0;
            y: 67px + direct.under;
            width: direct.inner-width;
            height: 20px;
            text: PlayView.host-message != "" ? PlayView.host-message : @tr("Send this address to your opponent.");
            color: PlayView.host-message != "" ? Theme.bad : Theme.muted;
            wrap: no-wrap;
            overflow: elide;
        }

        Rule {
            x: 0;
            y: 100px + direct.under;
            width: direct.inner-width;

            Rectangle { }  // (Copied in: docs/app.md §14.)
        }

        Label {
            x: 0;
            y: 114px + direct.under;
            width: direct.inner-width;
            height: 14px;
            text: I18n.upper(@tr("Join"));
        }

        Field {
            x: 0;
            y: 136px + direct.under;
            width: Theme.phone ? direct.inner-width : direct.inner-width - connect.width - 8px;
            nav: "direct.address";
            text: PlayView.address;
            placeholder: @tr("address:port");
            error: PlayView.join-message != "" && !PlayView.join-quiet;
        }

        connect := Button {
            x: direct.inner-width - self.width;
            y: 136px + 2 * direct.under + (Theme.phone ? 18px : 0px);
            width: Theme.phone ? direct.inner-width : self.natural-width;
            nav: "direct.connect";
            text: I18n.upper(@tr("Connect"));
        }

        Message {
            x: 0;
            y: 180px + direct.under;
            width: direct.inner-width;
            text: PlayView.join-message;
            tone: PlayView.join-quiet ? Theme.muted : Theme.bad;
        }

        Button {
            x: direct.inner-width - self.width;
            y: 212px + 2 * direct.under;
            nav: "direct.cancel";
            text: I18n.upper(@tr("Cancel"));
            kind: ButtonKind.ghost;
        }
    }

    // The code a box a character, for a pad: Up and Down change a box's character, Enter goes to the next.
    if PlayView.boxes: boxes := DialogFrame {
        property <length> box: Theme.handheld ? 40px : 52px;
        property <length> gap: Theme.handheld ? 4px : 8px;
        property <length> left: (self.inner-width - 6 * self.box - 5 * self.gap - 2 * self.gap) / 2;
        title: @tr("Invite code");
        panel-width: 460px;
        content-height: 128px;
        for i in 6: CodeBox {
            // (In threes, as the code is said.)
            x: boxes.left + i * (boxes.box + boxes.gap) + (i >= 3 ? 2 * boxes.gap : 0px);
            y: 0;
            width: boxes.box;
            nav: "boxes.\{i}";
            value: PlayView.box-characters[i];
            count: PlayView.code-set;

            Rectangle { }  // (Copied in: docs/app.md §14.)
        }

        Button {
            x: cancel.x - self.width - 12px;
            y: 88px;
            nav: "boxes.join";
            text: I18n.upper(@tr("Join"));
            kind: ButtonKind.main;
        }

        cancel := Button {
            x: boxes.inner-width - self.width;
            y: 88px;
            nav: "boxes.cancel";
            text: I18n.upper(@tr("Cancel"));
            kind: ButtonKind.ghost;
        }
    }

    // Client-local Stage & BGM mode and per-round configuration dialog.
    if PlayView.stage-dialog: stage := DialogFrame {
        property <bool> custom: PlayView.stage-mode == 3;
        property <length> mode-y: Theme.sideways ? 18px : 22px;
        property <length> mode-row-h: Theme.sideways ? 34px : 38px;
        property <length> mode-h: Theme.phone ? 2 * self.mode-row-h + 8px : self.mode-row-h;
        property <length> mode-btn-w: Theme.phone ? (self.inner-width - 8px) / 2 : (self.inner-width - 24px) / 4;
        property <length> desc-y: self.mode-y + self.mode-h + (Theme.sideways ? 6px : 10px);
        property <length> desc-h: Theme.sideways ? (self.custom ? 20px : 36px) : self.custom ? (Theme.phone ? 34px : 22px) : (Theme.phone ? 54px : 40px);
        property <length> list-y: Theme.sideways ? 96px : Theme.phone ? 182px : 142px;
        property <length> list-height: self.custom ? (Theme.sideways ? 122px : Theme.phone ? 216px : 240px) : 0px;
        property <length> row-height: Theme.phone ? 104px : 44px;
        property <length> row-pitch: self.row-height + 6px;
        property <length> footer-y: self.custom ? self.list-y + self.list-height + 12px : self.desc-y + self.desc-h + 14px;
        title: @tr("Stage & BGM");
        wide: true;
        panel-width: 640px;
        content-height: self.footer-y + 40px;

        Label {
            x: 0;
            y: 0;
            width: stage.inner-width;
            height: 14px;
            text: I18n.upper(@tr("Mode"));
        }

        Button {
            x: 0;
            y: stage.mode-y;
            width: stage.mode-btn-w;
            height: stage.mode-row-h;
            compact: true;
            nav: "stage.mode-0";
            kind: PlayView.stage-mode == 0 ? ButtonKind.main : ButtonKind.ghost;
            text: @tr("stage mode" => "Default");
        }

        Button {
            x: stage.mode-btn-w + 8px;
            y: stage.mode-y;
            width: stage.mode-btn-w;
            height: stage.mode-row-h;
            compact: true;
            nav: "stage.mode-1";
            kind: PlayView.stage-mode == 1 ? ButtonKind.main : ButtonKind.ghost;
            text: @tr("stage mode" => "Full random");
        }

        Button {
            x: Theme.phone ? 0px : 2 * (stage.mode-btn-w + 8px);
            y: Theme.phone ? stage.mode-y + stage.mode-row-h + 8px : stage.mode-y;
            width: stage.mode-btn-w;
            height: stage.mode-row-h;
            compact: true;
            nav: "stage.mode-2";
            kind: PlayView.stage-mode == 2 ? ButtonKind.main : ButtonKind.ghost;
            text: @tr("stage mode" => "Escalating");
        }

        Button {
            x: Theme.phone ? stage.mode-btn-w + 8px : 3 * (stage.mode-btn-w + 8px);
            y: Theme.phone ? stage.mode-y + stage.mode-row-h + 8px : stage.mode-y;
            width: stage.mode-btn-w;
            height: stage.mode-row-h;
            compact: true;
            nav: "stage.mode-3";
            kind: PlayView.stage-mode == 3 ? ButtonKind.main : ButtonKind.ghost;
            text: @tr("stage mode" => "Custom");
        }

        Note {
            x: 0;
            y: stage.desc-y;
            width: stage.inner-width;
            height: stage.desc-h;
            text: PlayView.stage-mode == 1 ? @tr("Every round picks a random background from the full pool and a random battle BGM.")
                : PlayView.stage-mode == 2 ? @tr("Virus battle on normal rounds, Boss battle on single match point, Final Boss on double match point (or 1st-to-1).")
                : PlayView.stage-mode == 3 ? @tr("Configure each round's background and BGM ({} rounds max, First to {}).", PlayView.stage-rounds.length, PlayView.first-to)
                : @tr("Matches GBA link battle rules (random link battle stage background and default link battle BGM).");
            color: Theme.muted;
            wrap: word-wrap;
        }

        if stage.custom && !Theme.phone && !Theme.sideways: Rule {
            x: 0;
            y: stage.list-y - 28px;
            width: stage.inner-width;

            Rectangle { }
        }

        if stage.custom && !Theme.phone && !Theme.sideways: Rectangle {
            x: 0;
            y: stage.list-y - 20px;
            width: stage.inner-width;
            height: 16px;
            property <length> col-w: (stage.inner-width - 104px) / 2;

            Label {
                x: 4px;
                width: 78px;
                height: 16px;
                text: I18n.upper(@tr("Round"));
            }

            Label {
                x: 88px;
                width: parent.col-w;
                height: 16px;
                text: I18n.upper(@tr("Background"));
            }

            Label {
                x: 88px + parent.col-w + 8px;
                width: parent.col-w;
                height: 16px;
                text: I18n.upper(@tr("BGM"));
            }
        }

        if stage.custom: stage-scroll := ScrollPage {
            x: 0;
            y: stage.list-y;
            width: stage.inner-width;
            height: stage.list-height;
            nav: "stage.list.";
            content-height: max(0px, PlayView.stage-rounds.length * stage.row-pitch - 6px);
            for entry[i] in PlayView.stage-rounds: Rectangle {
                property <length> col-w: (stage-scroll.view-width - 96px) / 2;
                x: 0;
                y: i * stage.row-pitch;
                width: stage-scroll.view-width;
                height: stage.row-height;

                Rectangle {
                    visible: Theme.phone;
                    background: Theme.inset;
                    border-width: 1px;
                    border-color: Theme.line;
                }

                Value {
                    x: Theme.phone ? 10px : 4px;
                    y: Theme.phone ? 6px : 4px;
                    width: Theme.phone ? stage-scroll.view-width - 20px : 80px;
                    height: Theme.phone ? 16px : 36px;
                    font-size: Theme.phone ? 12px : 13px;
                    color: Theme.muted;
                    text: @tr("Round {}", i + 1);
                }

                bg-sel := Select {
                    x: Theme.phone ? 10px : 88px;
                    y: Theme.phone ? 24px : 4px;
                    width: Theme.phone ? stage-scroll.view-width - 20px : parent.col-w;
                    height: Theme.phone ? 34px : 36px;
                    nav: "stage.list.bg";
                    nav-index: i;
                    value: entry.bg;
                }

                Select {
                    x: Theme.phone ? 10px : bg-sel.x + bg-sel.width + 8px;
                    y: Theme.phone ? 62px : 4px;
                    width: Theme.phone ? stage-scroll.view-width - 20px : stage-scroll.view-width - self.x;
                    height: Theme.phone ? 34px : 36px;
                    nav: "stage.list.bgm";
                    nav-index: i;
                    value: entry.bgm;
                }
            }
        }

        Button {
            x: 0;
            y: stage.footer-y;
            visible: stage.custom;
            enabled: stage.custom;
            nav: "stage.reset";
            text: I18n.upper(@tr("Reset"));
            kind: ButtonKind.ghost;
        }

        Button {
            x: stage.inner-width - self.width;
            y: stage.footer-y;
            nav: "stage.close";
            text: I18n.upper(@tr("Done"));
            kind: ButtonKind.main;
        }
    }

    // Per-effect ChargeShot Addition probability fix configuration dialog (EXE5 / EXE6).
    if PlayView.cs-prob-dialog: CsProbDialog {
        items: PlayView.cs-prob-items;
        editable: PlayView.host;
        nav-prefix: "cs-prob.";
    }

    // Dark Soul AI (ABD) version mechanics reference dialog (EXE4 / EXE5).
    if PlayView.abd-guide-dialog: AbdGuideDialog {
        active-mode: PlayView.abd-mode;
        has-ds: PlayView.abd-has-ds;
        nav-prefix: "abd-guide.";
    }

    // Another build for the lobby: the player's builds of the game.
    if PlayView.changing: change := DialogFrame {
        // (Four rows shown on a phone held sideways, five elsewhere.)
        property <length> list-height: Theme.sideways ? 216px : 268px;
        title: @tr("Change build");
        panel-width: 460px;
        content-height: self.list-height + 54px;
        list := ListView {
            x: 0;
            y: 0;
            width: change.inner-width;
            height: change.list-height;
            nav: "change.builds";
            count: PlayView.builds.length;
            row-height: 52px;
            chosen: PlayView.chosen;
            for slot in list.shown: BuildRow {
                property <int> at: list.first + slot;
                x: 0;
                y: self.at * list.pitch;
                width: list.row-width;
                height: list.row-height;
                build: PlayView.builds[self.at];
                nav: list.nav;
                nav-index: self.at;
            }
        }

        Button {
            x: change.inner-width - self.width;
            y: change.list-height + 14px;
            nav: "change.cancel";
            text: I18n.upper(@tr("Cancel"));
            kind: ButtonKind.ghost;
        }
    }

    // EXE6 Random Battle pre-battle prep: stats confirmation, 30-chip folder check, and Regular (30MB) / Tag (60MB) selection.
    if PlayView.random-prep: prep := DialogFrame {
        property <bool> narrow: Theme.phone;
        property <length> left-w: self.narrow ? self.inner-width : 272px;
        property <length> right-x: self.narrow ? 0px : self.left-w + 16px;
        property <length> right-w: self.narrow ? self.inner-width : self.inner-width - self.right-x;
        property <length> body-h: self.narrow ? 430px : 416px;
        property <length> footer-y: self.body-h + 12px;
        title: @tr("Random Battle — Rank {}", PlayView.prep-rank);
        panel-width: self.narrow ? 356px : 760px;
        content-height: self.footer-y + 38px;

        // ---- Left column (or top summary on phone): MegaMan stats & abilities + Regular/Tag controls.
        Rectangle {
            x: 0;
            y: 0;
            width: prep.left-w;
            height: prep.narrow ? 148px : prep.body-h;
            background: Theme.inset;
            border-width: 1px;
            border-color: Theme.line;
            border-radius: 4px;

            Image {
                x: 10px;
                y: 10px;
                width: prep.narrow ? 36px : 48px;
                height: prep.narrow ? 36px : 48px;
                source: PlayView.prep-sheet.face;
                image-rendering: pixelated;
            }

            Value {
                x: prep.narrow ? 54px : 68px;
                y: 10px;
                width: parent.width - self.x - 10px;
                height: 20px;
                text: PlayView.prep-sheet.navi;
                font-size: 14px;
            }

            Note {
                x: prep.narrow ? 54px : 68px;
                y: 30px;
                width: parent.width - self.x - 10px;
                height: 20px;
                text: @tr("HP {} · {}/{}/{} · Custom {}", PlayView.prep-sheet.stats.length > 0 ? PlayView.prep-sheet.stats[0].value : "", PlayView.prep-sheet.stats.length > 1 ? PlayView.prep-sheet.stats[1].value : "", PlayView.prep-sheet.stats.length > 2 ? PlayView.prep-sheet.stats[2].value : "", PlayView.prep-sheet.stats.length > 3 ? PlayView.prep-sheet.stats[3].value : "", PlayView.prep-sheet.stats.length > 4 ? PlayView.prep-sheet.stats[4].value : "");
                color: Theme.cursor;
            }

            // Abilities (SuperArmor / UnderShirt / AirShoes / ChipShuffle / Shield).
            Note {
                x: 10px;
                y: prep.narrow ? 52px : 68px;
                width: parent.width - 20px;
                height: prep.narrow ? 18px : 36px;
                text: @tr("Abilities: {}", I18n.join(PlayView.prep-sheet.abilities));
                color: Theme.text;
                wrap: word-wrap;
            }

            Rule {
                x: 10px;
                y: prep.narrow ? 74px : 112px;
                width: parent.width - 20px;
                Rectangle { }
            }

            // Regular & Tag memory usage.
            Note {
                x: 10px;
                y: prep.narrow ? 80px : 122px;
                width: parent.width - 20px;
                height: 18px;
                text: @tr("Reg {}/30 MB · Tag {}/60 MB", PlayView.prep-reg-mb, PlayView.prep-tag-mb);
                color: PlayView.prep-tagging ? Theme.action : Theme.text;
            }

            // Regular / Tag / Clear buttons for the focused chip.
            HorizontalLayout {
                x: 10px;
                y: prep.narrow ? 102px : 148px;
                width: parent.width - 20px;
                height: 32px;
                spacing: 6px;

                Button {
                    horizontal-stretch: 1;
                    height: 32px;
                    compact: true;
                    nav: "prep.reg";
                    enabled: !PlayView.prep-ready;
                    kind: ButtonKind.ghost;
                    text: @tr("Reg (R)");
                }

                Button {
                    horizontal-stretch: 1;
                    height: 32px;
                    compact: true;
                    nav: "prep.tag";
                    enabled: !PlayView.prep-ready;
                    kind: PlayView.prep-tagging ? ButtonKind.normal : ButtonKind.ghost;
                    text: @tr("Tag (T)");
                }

                Button {
                    horizontal-stretch: 1;
                    height: 32px;
                    compact: true;
                    nav: "prep.clear";
                    enabled: !PlayView.prep-ready && (PlayView.prep-reg-mb > 0 || PlayView.prep-tag-mb > 0 || PlayView.prep-tagging);
                    kind: ButtonKind.ghost;
                    text: I18n.upper(@tr("Clear"));
                }
            }

            // Notice / refusal (e.g. over 30 MB Regular or 60 MB Tag) or Tag prompt.
            Note {
                x: 10px;
                y: 190px;
                width: parent.width - 20px;
                height: 54px;
                visible: !prep.narrow;
                text: PlayView.prep-notice != "" ? PlayView.prep-notice
                    : PlayView.prep-tagging ? @tr("Select a second chip to complete the Tag pair (max 60 MB total).")
                    : @tr("Inspect the shared 30-chip folder and optionally set your Regular (30 MB) and Tag (60 MB) chips.");
                color: PlayView.prep-notice != "" ? Theme.bad : PlayView.prep-tagging ? Theme.action : Theme.muted;
                wrap: word-wrap;
            }

            // Opponent & local ready status.
            Note {
                x: 10px;
                y: parent.height - 46px;
                width: parent.width - 20px;
                height: 36px;
                visible: !prep.narrow;
                text: PlayView.prep-ready && !PlayView.prep-their-ready ? @tr("Ready! Waiting for opponent…")
                    : !PlayView.prep-ready && PlayView.prep-their-ready ? @tr("Opponent is ready.")
                    : "";
                color: PlayView.prep-ready ? Theme.cursor : Theme.action;
                wrap: word-wrap;
            }
        }

        // ---- Right column (or bottom list on phone): 30-chip folder inspection & selection.
        Rectangle {
            x: prep.right-x;
            y: prep.narrow ? 156px : 0px;
            width: prep.right-w;
            height: prep.narrow ? prep.body-h - 156px : prep.body-h;

            Note {
                x: 4px;
                y: 0;
                width: parent.width - 8px;
                height: 20px;
                text: PlayView.prep-detail != "" ? PlayView.prep-detail : @tr("Shared Random Folder (30 chips)");
                color: Theme.cursor;
                overflow: elide;
            }

            prep-list := ListView {
                x: 0;
                y: 24px;
                width: parent.width;
                height: parent.height - 24px;
                nav: "prep.slot";
                count: PlayView.prep-sheet.chips.length;
                row-height: Theme.handheld ? 36px : Theme.chip-row;
                chosen: PlayView.prep-slot;
                for slot in prep-list.shown: Rectangle {
                    property <int> at: prep-list.first + slot;
                    y: self.at * prep-list.pitch;
                    width: prep-list.row-width;
                    height: prep-list.row-height;
                    ChipRow {
                        width: parent.width;
                        big: Theme.handheld;
                        chip: PlayView.prep-sheet.chips[parent.at];
                        number: parent.at + 1;
                        chosen: parent.at == PlayView.prep-slot;
                        hover: !Theme.handheld && prep-touch.has-hover;
                    }
                    prep-touch := RowTouch {
                        nav: "prep.slot";
                        nav-index: parent.at;
                        describes: true;
                    }
                }
            }
        }

        Button {
            x: 0;
            y: prep.footer-y;
            nav: "prep.leave";
            text: I18n.upper(@tr("Leave"));
            kind: ButtonKind.ghost;
            danger: true;
        }

        Button {
            x: prep.inner-width - self.width;
            y: prep.footer-y;
            nav: "prep.ready";
            text: PlayView.prep-ready ? I18n.upper(@tr("Cancel")) : I18n.upper(@tr("Ready"));
            kind: PlayView.prep-ready ? ButtonKind.ghost : ButtonKind.main;
        }
    }
}
