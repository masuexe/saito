msgstr "フォント"

msgid "No license stated"
msgstr "ライセンスの記載なし"

msgid "Its package comes with no license file. Its license is the one named above."
msgstr "このパッケージにはライセンスファイルが含まれていません。ライセンスは上に記載のとおりです。"

msgid "Check for updates"
msgstr "更新を確認"

# The party battle's two navi changes (EXE5 DS's Y and X: the party panel's left and right buttons).
msgid "Navi change left"
msgstr "ナビチェンジ（左）"

msgid "Navi change right"
msgstr "ナビチェンジ（右）"

msgid "Signaling server"
msgstr "シグナリングサーバー"

msgid "Leave blank for the default server. Include ws:// or wss://."
msgstr "空欄の場合は既定のサーバーを使用します。ws:// または wss:// を含めてください。"

msgid "Send to phone"
msgstr "スマートフォンに送信"

msgid "Enter the address shown on the phone to send the Legacy Collection over Wi-Fi."
msgstr "スマートフォンに表示されたアドレスを入力すると、Wi-Fi 経由でアドバンスドコレクションを送信できます。"

msgid "Landscape touch pad"
msgstr "横画面タッチパッド"

msgid "Show on-screen controls in landscape."
msgstr "横画面のバトル中に画面上の仮想ボタンを表示します。"

msgid "Touch pad layout"
msgstr "タッチパッド配置"

msgid "Customize button positions and sizes."
msgstr "仮想ボタンの位置とサイズをカスタマイズします。"

msgid "Customize"
msgstr "カスタマイズ"

msgid "Portrait"
msgstr "縦画面"

msgid "Landscape"
msgstr "横画面"

msgid "Drag buttons to move. Use − / + to resize."
msgstr "ボタンをドラッグして移動し、− / + でサイズを調整します。"

msgid "D-Pad"
msgstr "十字キー"

msgid "Reset"
msgstr "リセット"

msgid "Keyboard-only custom screen"
msgstr "キーボード専用カスタム画面"

msgid "Disable mouse and touch chip selection on the custom screen."
msgstr "カスタム画面でのマウス・タッチによるチップ選択を無効にします。"

msgid "Hide status bar in landscape"
msgstr "横画面でステータスバーを隠す"

msgid "Hide Android's top status bar while holding the phone sideways."
msgstr "横向き表示のときに Android の上部ステータスバーを非表示にします。"

msgid "Check now"
msgstr "今すぐ確認"

msgid "You're on the latest version."
msgstr "最新バージョンです。"

msgid "Couldn't check for updates."
msgstr "更新を確認できませんでした。"

msgid "Auto-upload replays"
msgstr "リプレイの自動アップロード"

msgid "Automatically upload finished online replays to the server's Recent Replays feed. Off by default."
msgstr "オンライン対戦終了後、リプレイをサーバーの「最近のリプレイ」に自動アップロードします。初期設定はオフです。"

msgid "ABD usage stats"
msgstr "ABD使用統計"

msgid "No records yet."
msgstr "記録はまだありません。"

msgid "{} rounds (GBA: {} · LC: {} · NDS: {})"
msgstr "{} ラウンド（GBA: {} ・ アドコレ: {} ・ NDS: {}）"

msgid "Quick shout"
msgstr "クイック叫び"

msgid "EXE5DS ROM"
msgstr "EXE5DS ROM"

msgid "Not set (using GBA fallback)"
msgstr "未設定（GBA 代替素材を使用）"

msgid "EXE5DS battle music"
msgstr "EXE5DS バトルBGM"

msgid "Use arranged DS battle themes by default in EXE5 (requires EXE5DS ROM)."
msgstr "EXE5の通常対戦で5DSアレンジBGMを優先再生する（EXE5DS ROMが必要）。"

msgid "EXE5DS battle voices"
msgstr "EXE5DS バトルボイス"

msgid "Play DS battle voices in EXE5 (requires EXE5DS ROM)."
msgstr "EXE5の対戦中に5DSバトルボイスを再生する（EXE5DS ROMが必要）。"

msgid "EXE5DS Crisis Microphone"
msgstr "EXE5DS ピンチ時マイク"

msgid "Danger microphone"
msgstr "ピンチ時にマイクを自動有効化"

msgid "Auto-enable microphone in Danger state."
msgstr "ピンチ状態の間のみマイクを自動で有効にし、終了時に即座に閉じます。"

msgid "Mic sensitivity"
msgstr "マイク感度"

msgid "Microphone gain (25–400%). Default is 100%."
msgstr "マイク入力ゲイン（25–400%）。初期値は 100%。"

msgid "Mic test"
msgstr "マイクテスト"

msgid "Peak: High"
msgstr "ピーク：大"

msgid "Peak: Medium"
msgstr "ピーク：中"

msgid "Peak: Low"
msgstr "ピーク：小"

msgid "Listening…"
msgstr "入力待機中…"

msgid "Test Low / Medium / High shout thresholds."
msgstr "小・中・大の3段階の音量しきい値をテストします。"

msgid "Stop test"
msgstr "テスト停止"

msgid "Test mic"
msgstr "マイクテスト"

msgid "Quick-Shout tier"
msgstr "クイック叫び音量"

msgid "Volume tier sent by the Quick-Shout key or button in 3-Tier mode."
msgstr "3段階音量モードでクイック叫びキー／ボタンを押した際に送信する音量。"

msgid "Low"
msgstr "小"

msgid "Medium"
msgstr "中"

msgid "High"
msgstr "大"

msgid "Screen orientation"
msgstr "画面の向き"

msgid "Lock portrait or landscape, auto-rotate in battle only, or follow gravity."
msgstr "縦画面・横画面の固定、バトル中のみ自動横画面、または自動回転を選択します。"

msgid "Battle landscape"
msgstr "バトル中のみ横画面"

msgid "Follow gravity"
msgstr "自動回転"

msgid "Switch to landscape"
msgstr "横画面に切替"

msgid "Switch to portrait"
msgstr "縦画面に切替"
