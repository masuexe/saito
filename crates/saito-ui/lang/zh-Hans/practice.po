# ---- The practice menu's rows ----

# The DUMMY group's: the dummy's build, one of the game's builds.
msgid "Dummy's build"
msgstr "假人的构筑"

# The STAGE group's: where each round is fought. Their choices are the content's arenas and backgrounds, after
# Random (each round's picked from the seed).
msgid "Arena"
msgstr "场地"

msgid "Background"
msgstr "背景"

msgid "Random"
msgstr "随机"

# ---- Before the battle, and in it ----

msgid "Dummy"
msgstr "假人"

# Beside MENU on a phone: {} is the round's number.
msgid "Practice · Round {}"
msgstr "练习 · 第 {} 回合"

# ---- The practice menu ----

# Under the menu's title: the two builds' names.
msgid "{} vs {}"
msgstr "{} vs {}"

# The menu's groups: where the battle is fought (the arena, the background, the music), and the battle's options.
msgid "Stage"
msgstr "场景"

msgid "Options"
msgstr "选项"

msgid "Action"
msgstr "行动"

msgid "Stands still"
msgstr "原地不动"

msgid "Moves around"
msgstr "四处移动"

# The dummy fights as a player would, as well as its Level lets it.
msgid "Fights"
msgstr "战斗"

# The dummy is played on a second connected gamepad.
msgid "A second pad"
msgstr "第二个手柄"

# EXE5-only dummy action: permanent DarkInvs running 4x DarkThnd + 1x BigNoise.
msgid "DarkInvs (Thnd/PA)"
msgstr "黑暗隐身 (黑暗雷电/巨大噪音)"

# How well the dummy fights: a row under the Action while it is Fights.
msgid "Level"
msgstr "强度"

msgctxt "level"
msgid "Easy"
msgstr "简单"

msgctxt "level"
msgid "Normal"
msgstr "普通"

msgctxt "level"
msgid "Hard"
msgstr "困难"

# Battle, rows of two columns under the headings YOU and DUMMY, a value for each side: a side's HP stays as it
# goes, or comes back full once a hit is over.
msgid "HP"
msgstr "HP"

msgid "Normal"
msgstr "正常"

msgid "Refills"
msgstr "回满"

# Each side's navi held in one of the game's emotions (their words the content's), or as the game goes (Normal,
# the HP row's word).
msgid "Emotion"
msgstr "情绪"

msgid "Custom gauge"
msgstr "改装计量表"

msgid "Always full"
msgstr "始终全满"

# The order the custom screen deals the folder in: shuffled, or from the folder's top.
msgid "Chip draw"
msgstr "芯片抽取"

msgid "Shuffled"
msgstr "洗牌"

msgid "Folder order"
msgstr "文件夹顺序"

msgid "Input display"
msgstr "输入显示"

msgid "Off"
msgstr "关"

msgid "On"
msgstr "开"

msgid "Resume"
msgstr "继续"

msgid "Restart"
msgstr "重新开始"

# Ends the session: back to Practice's entry.
msgid "Exit"
msgstr "退出"

# ---- Over the battle ----

# In a corner over the battle, beside a count of chips ("34/58"): the dummy that fights is getting ready, its
# chips being looked at before it can play (a few seconds, the first time a folder's chips are met).
msgid "Getting ready"
msgstr "准备中"

msgid "Random Battle"
msgstr "随机卡组战"

msgid "Rank 1"
msgstr "Rank 1"

msgid "Rank 2"
msgstr "Rank 2"

msgid "Rank 3"
msgstr "Rank 3"

msgid "Dark Soul AI"
msgstr "黑暗之魂 AI"

msgid "Original"
msgstr "原版"

msgid "Legacy Collection"
msgstr "合集版"

msgid "DS"
msgstr "NDS 版"

msgid "ABD Chip Cap"
msgstr "ABD 芯片上限"
